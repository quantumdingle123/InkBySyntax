local CatTugOfWar = GamesTab:CreateCategory("Tug Of War", false, 4)

local function isTugOfWarActive()
    if isCurrentGame("TugOfWar") or isCurrentGame("Tug Of War") then return true end
    local pGui = localPlayer:FindFirstChild("PlayerGui")
    if pGui and (pGui:FindFirstChild("TugOfWarUIV2") or pGui:FindFirstChild("TugOfWarUI") or pGui:FindFirstChild("TugofWarRemake")) then
        return true
    end
    local char = localPlayer.Character
    return char and (char:FindFirstChild("RopeTool") or char:FindFirstChild("Rope")) ~= nil
end

local function getAngleDelta(a, b)
    return math.abs((a - b + 180) % 360 - 180)
end

local function triggerTugPull(circleBase)
    simulateKey("space")
    if circleBase then
        local btn = circleBase:FindFirstChildWhichIsA("TextButton", true)
        if btn and typeof(firesignal) == "function" then
            pcall(function()
                firesignal(btn.MouseButton1Click)
                firesignal(btn.Activated)
            end)
        end
    end
end

local isTugLoopRunning = false
local function handleTugOfWarSession()
    if isTugLoopRunning then return end
    isTugLoopRunning = true

    local pGui = localPlayer:FindFirstChild("PlayerGui")
    if not pGui then isTugLoopRunning = false; return end
    local ui = pGui:WaitForChild("TugOfWarUIV2", 4) or pGui:FindFirstChild("TugOfWarUI")
    local remake = ui and (ui:FindFirstChild("TugofWarRemake") or ui)
    local circleBase = remake and remake:FindFirstChild("CircleBase")
    if not circleBase then isTugLoopRunning = false; return end

    local arrow = circleBase:FindFirstChild("Arrow")
    local medium = circleBase:FindFirstChild("Medium") or circleBase:FindFirstChild("Small") or circleBase:FindFirstChild("Large")
    if not (arrow and medium) then isTugLoopRunning = false; return end

    local strategy = localPlayer:GetAttribute("TugOfWarStrategy") or "Standard"
    local threshold = (strategy == "Stall") and 14.0 or 18.2
    local conn = nil

    local function cleanup()
        if conn then conn:Disconnect(); conn = nil end
        isTugLoopRunning = false
    end

    conn = RunService.RenderStepped:Connect(function()
        if not (State.tugOfWarAutoPullEnabled or State.tugOfWarAntiMissEnabled) or not circleBase.Visible or not isTugOfWarActive() then
            cleanup()
            return
        end

        local arrowRot = arrow.Rotation % 360
        if State.tugOfWarAntiMissEnabled then
            medium.Rotation = arrowRot
        end

        if State.tugOfWarAutoPullEnabled then
            local delta = getAngleDelta(medium.Rotation % 360, arrowRot)
            if delta <= threshold or State.tugOfWarAntiMissEnabled then
                if tick() - Timestamps.lastPressTime > 0.25 then
                    triggerTugPull(circleBase)
                    Timestamps.lastPressTime = tick()
                end
            end
        end
    end)
end

