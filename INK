local function isPlayerInRLGLSafeZone()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = hrp.Position
    local function inBox(p, minB, maxB)
        return p.X >= math.min(minB.X, maxB.X) and p.X <= math.max(minB.X, maxB.X)
           and p.Z >= math.min(minB.Z, maxB.Z) and p.Z <= math.max(minB.Z, maxB.Z)
    end
    if (inBox(pos, Vector3.new(115, 1023, 84), Vector3.new(103, 1023, 168))
     or inBox(pos, Vector3.new(103, 1023, 168), Vector3.new(-216, 1023, 83)))
     and math.abs(pos.Y - 1023) < 100 then
        return true
    end
    return false
end

local prevWalkSpeed = 16
local prevJumpPower = 50
local function setPlayerFrozen(freeze)
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if freeze then
        if hum.WalkSpeed > 0 then prevWalkSpeed = hum.WalkSpeed end
        if hum.JumpPower > 0 then prevJumpPower = hum.JumpPower end
        hum.WalkSpeed = 0
        hum.JumpPower = 0
    else
        hum.WalkSpeed = prevWalkSpeed
        hum.JumpPower = prevJumpPower
    end
end

