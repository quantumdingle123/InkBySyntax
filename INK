local CatTugOfWar = GamesTab:CreateCategory("Tug Of War", false, 4)

local function calcAngularDist(a, b)
    return math.abs((a - b + 180) % 360 - 180)
end

local function triggerTugPull(circleBase)
    if circleBase then
        local btn = circleBase:FindFirstChild("TextButton") or circleBase:FindFirstChildWhichIsA("TextButton")
        if btn and typeof(firesignal) == "function" then
            pcall(firesignal, btn.MouseButton1Click)
            pcall(firesignal, btn.Activated)
        end
    end
    pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("Remotes")
        local pullRem = rem and (rem:FindFirstChild("TugPull") or rem:FindFirstChild("PullRope")) or ReplicatedStorage:FindFirstChild("PullRope", true)
        if pullRem and pullRem:IsA("RemoteEvent") then
            pullRem:FireServer()
        end
    end)
end

local towRenderConn = nil
local lastTOWPress = 0

local function checkAndRunTOW()
    if not (State.autoPullEnabled or State.antiMissEnabled) then
        if towRenderConn then
            towRenderConn:Disconnect()
            towRenderConn = nil
        end
        return
    end

    local pGui = localPlayer:FindFirstChildOfClass("PlayerGui")
    if not pGui then return end

    local towUI = pGui:FindFirstChild("TugOfWarUIV2") or pGui:FindFirstChild("TugOfWarUI")
    local remake = towUI and (towUI:FindFirstChild("TugofWarRemake") or towUI)
    local circleBase = remake and remake:FindFirstChild("CircleBase")

    if not circleBase or not circleBase.Visible then return end

    local arrow = circleBase:FindFirstChild("Arrow")
    local medium = circleBase:FindFirstChild("Medium") or circleBase:FindFirstChild("Small") or circleBase:FindFirstChild("Large")

    if not arrow or not medium then return end

    local rot = arrow.Rotation % 360
    local isAligned = calcAngularDist(medium.Rotation % 360, rot) <= 18.2

    if State.antiMissEnabled then
        medium.Rotation = rot
        isAligned = true
    end

    if State.autoPullEnabled then
        local now = tick()
        if State.antiMissEnabled then
            if now - lastTOWPress > 0.25 then
                triggerTugPull(circleBase)
                lastTOWPress = now
            end
        elseif isAligned and (now - lastTOWPress > 0.12) then
            triggerTugPull(circleBase)
            lastTOWPress = now
        end
    end
end

local function startTOWThread()
    if not towRenderConn then
        towRenderConn = RunService.RenderStepped:Connect(function()
            if State.autoPullEnabled or State.antiMissEnabled then
                checkAndRunTOW()
            else
                if towRenderConn then
                    towRenderConn:Disconnect()
                    towRenderConn = nil
                end
            end
        end)
        table.insert(Connections, towRenderConn)
    end
end

