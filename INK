local function getWeaponTool()
    local char = localPlayer.Character
    if not char then return nil end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item:FindFirstChild("GunScript") or item:FindFirstChild("FireEvent") or item:FindFirstChild("Shoot") or item:FindFirstChild("Rifle") or item:FindFirstChild("Pistol") or item:FindFirstChild("Handle")) then
            return item
        end
    end
    local bp = localPlayer:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and (item:FindFirstChild("GunScript") or item:FindFirstChild("FireEvent") or item:FindFirstChild("Shoot") or item:FindFirstChild("Rifle") or item:FindFirstChild("Pistol") or item:FindFirstChild("Handle")) then
                return item
            end
        end
    end
    return nil
end

local function fireActiveWeapon(targetPosition, targetInstance)
    local tool = getWeaponTool()
    if not tool then return false end

    local shootRemote = tool:FindFirstChild("Shoot")
        or tool:FindFirstChild("Fire")
        or tool:FindFirstChild("FireEvent")
        or ReplicatedStorage:FindFirstChild("Shoot")
        or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Shoot"))

    if shootRemote and shootRemote:IsA("RemoteEvent") then
        pcall(function()
            shootRemote:FireServer(targetPosition, targetInstance)
        end)
        return true
    end

    RemoteEngine:UseTool(tool.Name, "Shoot", {
        Hit = targetPosition,
        Target = targetInstance,
        Position = targetPosition
    })
    return true
end

