-- [3.2] Mini-Game State Detector (500ms Caching)
local cachedGame = nil
local lastGameCheck = 0

local function getCurrentGame()
    if tick() - lastGameCheck < 0.5 then
        return cachedGame
    end
    lastGameCheck = tick()
    local values = Workspace:FindFirstChild("Values")
    local currentGameObj = values and values:FindFirstChild("CurrentGame")
    if currentGameObj and currentGameObj.Value ~= "" then
        cachedGame = currentGameObj.Value
    else
        cachedGame = nil
    end
    return cachedGame
end

local function isCurrentGame(gameName)
    return getCurrentGame() == gameName
end

-- [3.3] Remote Introspection & Garbage Collection Scanner
local RemoteEngine = { Cache = {} }

function RemoteEngine:GetWrapper(remoteName)
    if self.Cache[remoteName] then
        return self.Cache[remoteName]
    end

    local searchGC = (typeof(filtergc) == "function" and function() return filtergc("table", {}, false) end)
        or (typeof(getgc) == "function" and function() return getgc(true) end)

    if searchGC and typeof(debug.getupvalue) == "function" then
        local ok, tables = pcall(searchGC)
        if ok and type(tables) == "table" then
            for _, tbl in ipairs(tables) do
                if typeof(tbl) == "table" then
                    local ok2, fire = pcall(rawget, tbl, "FireServer")
                    if ok2 and typeof(fire) == "function" and (not islclosure or islclosure(fire)) then
                        for i = 1, 40 do
                            local ok3, upval = pcall(debug.getupvalue, fire, i)
                            if ok3 and typeof(upval) == "Instance" and upval:IsA("RemoteEvent") and upval.Name == remoteName then
                                self.Cache[remoteName] = tbl
                                return tbl
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

function RemoteEngine:Fire(remoteName, ...)
    local wrapper = self:GetWrapper(remoteName)
    if wrapper and typeof(wrapper.FireServer) == "function" then
        return select(1, pcall(wrapper.FireServer, wrapper, ...))
    end
    local direct = ReplicatedStorage:FindFirstChild(remoteName, true)
    if direct and direct:IsA("RemoteEvent") then
        return select(1, pcall(direct.FireServer, direct, ...))
    end
    return false
end

function RemoteEngine:UseTool(toolName, moveName, data)
    if not toolName then return false end
    return self:Fire("UsedTool", moveName or "UsingMoveCustom", toolName, nil, data or { Clicked = true })
end

-- [3.4] Non-Anchoring Movement Restrictor (Zero Anchoring)
local originalWalkSpeed = 16
local controlsDisabled = false

local function setPlayerFrozen(freeze)
    local character = localPlayer.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if freeze then
        if hum then
            if hum.WalkSpeed > 0 then originalWalkSpeed = hum.WalkSpeed end
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            if hum.JumpHeight > 0 then hum.JumpHeight = 0 end
        end
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.Velocity = Vector3.zero
            hrp.RotVelocity = Vector3.zero
        end
        pcall(function()
            local pScripts = localPlayer:FindFirstChild("PlayerScripts")
            local pModule = pScripts and pScripts:FindFirstChild("PlayerModule")
            if pModule then
                local ctrl = require(pModule):GetControls()
                if ctrl and not controlsDisabled then
                    ctrl:Disable()
                    controlsDisabled = true
                end
            end
        end)
    else
        if hum then
            hum.WalkSpeed = originalWalkSpeed or 16
            hum.JumpPower = 50
            hum.JumpHeight = 7.2
        end
        pcall(function()
            local pScripts = localPlayer:FindFirstChild("PlayerScripts")
            local pModule = pScripts and pScripts:FindFirstChild("PlayerModule")
            if pModule then
                local ctrl = require(pModule):GetControls()
                if ctrl and controlsDisabled then
                    ctrl:Enable()
                    controlsDisabled = false
                end
            end
        end)
    end
end

-- [3.5] Crosshair & Smart Aimbot Targeting
local function getAimCenter()
    local cam = Workspace.CurrentCamera or camera
    if not cam then return Vector2.zero end
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return cam.ViewportSize / 2
    end
    local mLoc = UserInputService:GetMouseLocation()
    if mLoc and (mLoc.X > 0 or mLoc.Y > 0) then
        return mLoc
    end
    return cam.ViewportSize / 2
end

local function getSmartAimbotTarget(maxFovDistance)
    maxFovDistance = maxFovDistance or 350
    local cam = Workspace.CurrentCamera or camera
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not cam or not hrp then return nil end

    local aimCenter = getAimCenter()
    local bestTarget = nil
    local bestFovDist = maxFovDistance

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local pChar = p.Character
            local pHrp = pChar:FindFirstChild("HumanoidRootPart")
            local pHum = pChar:FindFirstChildOfClass("Humanoid")
            if pHrp and pHum and pHum.Health > 0 then
                local targetPart = (State.aimbotTargetPart == "Torso" and (pChar:FindFirstChild("UpperTorso")
                    or pChar:FindFirstChild("Torso")
                    or pHrp))
                    or pChar:FindFirstChild("Head")
                    or pHrp
                if targetPart then
                    local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                    if onScreen and screenPos.Z > 0 then
                        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - aimCenter).Magnitude
                        if distToCenter < bestFovDist then
                            bestFovDist = distToCenter
                            bestTarget = p
                        end
                    end
                end
            end
        end
    end

    -- Fallback: if no target in crosshair FOV, target closest in 3D distance (< 40 studs)
    if not bestTarget then
        local closest3dDist = 40
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= localPlayer and p.Character then
                local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local pHum = p.Character:FindFirstChildOfClass("Humanoid")
                if pHrp and pHum and pHum.Health > 0 then
                    local d = (pHrp.Position - hrp.Position).Magnitude
                    if d < closest3dDist then
                        closest3dDist = d
                        bestTarget = p
                    end
                end
            end
        end
    end

    return bestTarget
end

