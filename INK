local function getPlayerPower(player)
    if not player then return nil end
    local char = player.Character
    if char then
        local pVal = char:FindFirstChild("EquippedPower") or char:FindFirstChild("Power")
        if pVal and pVal:IsA("StringValue") and pVal.Value ~= "" then
            return pVal.Value
        end
        local attr = char:GetAttribute("Power") or char:GetAttribute("EquippedPower")
        if attr and type(attr) == "string" and attr ~= "" then
            return attr
        end
    end
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local powerVal = leaderstats:FindFirstChild("Power") or leaderstats:FindFirstChild("Special")
        if powerVal and powerVal:IsA("StringValue") and powerVal.Value ~= "" then
            return powerVal.Value
        end
    end
    return nil
end

