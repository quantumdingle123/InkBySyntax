-- ------------------------------------------------------------------------------
local CatPentathlon = GamesTab:CreateCategory("Pentathlon", false, 3)

local pentathlonGuid = nil
local pentathlonInitialized = false

local function ensurePentathlonInit()
    if pentathlonInitialized then return true end
    local ok = pcall(function()
        local modules = ReplicatedStorage:FindFirstChild("Modules")
        local gamesMod = modules and modules:FindFirstChild("Games")
        local clientMod = gamesMod and gamesMod:FindFirstChild("PentathlonClient")
        if clientMod then
            local PentathlonClient = require(clientMod)
            if type(PentathlonClient) == "table" then
                local origRun = PentathlonClient.RunServerGame
                if origRun then
                    PentathlonClient.RunServerGame = function(arg, ...)
                        if arg and arg.GUID then pentathlonGuid = arg.GUID end
                        return origRun(arg, ...)
                    end
                end
                local origAdd = PentathlonClient.AddActiveGame
                if origAdd then
                    PentathlonClient.AddActiveGame = function(arg)
                        if arg and arg.GUID then pentathlonGuid = arg.GUID end
                        return origAdd(arg)
                    end
                end
                pentathlonInitialized = true
            end
        end
    end)
    return ok and pentathlonInitialized
end

local function firePentathlon(action, data)
    ensurePentathlonInit()
    if not pentathlonGuid then return false end
    local remote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("PentathlonRemote")
    if remote then
        if data then
            remote:FireServer(pentathlonGuid, action, data)
        else
            remote:FireServer(pentathlonGuid, action)
        end
        return true
    end
    return false
end

