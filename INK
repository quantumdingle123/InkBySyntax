local function updateKeysESP(localPos, activeObjects)
    if not State.espKeysEnabled then return end
    local foundKeys = {}

    local function processKey(child)
        if not child or not child.Parent or foundKeys[child] then return end
        if string.sub(child.Name, 1, 10) == "DroppedKey" or string.find(child.Name, "Key") then
            local part = child:IsA("BasePart") and child or (child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 350 then
                    foundKeys[child] = true
                    activeObjects[child] = true
                    local keySuffix = string.lower(child.Name)
                    local keyConfig = {
                        width = 135,
                        offsetY = 1.6,
                        bgColor = Color3.fromRGB(22, 18, 10),
                        strokeColor = Color3.fromRGB(255, 215, 0),
                        textColor = Color3.fromRGB(255, 225, 80),
                        icon = ESPAssets.KeyCircle,
                        text = "Circle Key [" .. dist .. "m]"
                    }

                    if string.find(keySuffix, "square") then
                        keyConfig.bgColor = Color3.fromRGB(10, 18, 28)
                        keyConfig.strokeColor = Color3.fromRGB(0, 229, 255)
                        keyConfig.textColor = Color3.fromRGB(100, 240, 255)
                        keyConfig.icon = ESPAssets.KeySquare
                        keyConfig.text = "Square Key [" .. dist .. "m]"
                    elseif string.find(keySuffix, "triangle") then
                        keyConfig.bgColor = Color3.fromRGB(28, 10, 15)
                        keyConfig.strokeColor = Color3.fromRGB(255, 45, 85)
                        keyConfig.textColor = Color3.fromRGB(255, 90, 120)
                        keyConfig.icon = ESPAssets.KeyTriangle
                        keyConfig.text = "Triangle Key [" .. dist .. "m]"
                    elseif string.find(keySuffix, "circle") then
                        keyConfig.bgColor = Color3.fromRGB(22, 18, 10)
                        keyConfig.strokeColor = Color3.fromRGB(255, 215, 0)
                        keyConfig.textColor = Color3.fromRGB(255, 225, 80)
                        keyConfig.icon = ESPAssets.KeyCircle
                        keyConfig.text = "Circle Key [" .. dist .. "m]"
                    else
                        local cleanName = string.gsub(child.Name, "DroppedKey", "")
                        if cleanName == "" then cleanName = child.Name end
                        keyConfig.text = cleanName .. " [" .. dist .. "m]"
                    end

                    local entry = createOrGetObjectESP(child, keyConfig)
                    entry.label.Text = keyConfig.text
                    entry.label.TextColor3 = keyConfig.textColor
                    entry.stroke.Color = keyConfig.strokeColor
                    entry.icon.Image = keyConfig.icon
                    entry.gui.Adornee = part
                    entry.gui.Enabled = true
                end
            end
        end
    end

    local effects = Workspace:FindFirstChild("Effects")
    if effects then
        for _, child in ipairs(effects:GetChildren()) do
            processKey(child)
        end
    end
    -- Fallback: check workspace direct children if effects has no keys
    for _, child in ipairs(Workspace:GetChildren()) do
        if string.sub(child.Name, 1, 10) == "DroppedKey" then
            processKey(child)
        end
    end
end

local function updateExitDoorsESP(localPos, activeObjects)
    if not State.espExitDoorsEnabled then return end
    local hnsMap = Workspace:FindFirstChild("HideAndSeekMap")
    if not hnsMap then return end

    local foundDoors = {}
    local function processDoor(door)
        if not door or not door.Parent or foundDoors[door] then return end
        if string.find(string.upper(door.Name), "EXITDOOR") or string.find(string.upper(door.Name), "EXIT") then
            local part = door:IsA("BasePart") and door or (door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 350 then
                    foundDoors[door] = true
                    activeObjects[door] = true
                    local doorConfig = {
                        width = 145,
                        offsetY = 3.5,
                        bgColor = Color3.fromRGB(10, 25, 18),
                        strokeColor = Color3.fromRGB(0, 255, 140),
                        textColor = Color3.fromRGB(80, 255, 180),
                        icon = ESPAssets.ExitDoor,
