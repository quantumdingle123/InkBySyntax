-- ------------------------------------------------------------------------------
local CatGlass = GamesTab:CreateCategory("Glass Bridge", false, 5)

local glassHighlights = {}
local safeWalkwayParts = {}

local function getGlassType(part)
    if not part or not part:IsA("BasePart") then return nil end
    local isGlass = part:GetAttribute("GlassPart") ~= nil 
        or string.find(string.lower(part.Name), "glass") ~= nil 
        or (part.Parent and part.Parent:IsA("Model") and string.find(string.lower(part.Parent.Name), "glass"))
        or part.Material == Enum.Material.Glass
    if not isGlass then return nil end

    local actuallyKilling = part:GetAttribute("ActuallyKilling") ~= nil or (part.Parent and part.Parent:GetAttribute("ActuallyKilling") ~= nil)
    local delayedBreaking = part:GetAttribute("DelayedBreaking") ~= nil or (part.Parent and part.Parent:GetAttribute("DelayedBreaking") ~= nil)
    local exploitingisevil = part:GetAttribute("exploitingisevil") == true or (part.Parent and part.Parent:GetAttribute("exploitingisevil") == true)
    local breakable = part:GetAttribute("Breakable") == true or (part.Parent and part.Parent:GetAttribute("Breakable") == true)

    if (actuallyKilling and delayedBreaking) or delayedBreaking then
        return "delayed"
    end
    if actuallyKilling or exploitingisevil or breakable then
        return "fake"
    end
    return "real"
end

local function cleanGlassESP()
    for _, hl in pairs(glassHighlights) do
        if hl and hl.Parent then hl:Destroy() end
    end
    table.clear(glassHighlights)
end

local function updateGlassBridge()
    local bridge = Workspace:FindFirstChild("GlassBridge") or Workspace:FindFirstChild("GlassBridgeMap") or Workspace:FindFirstChild("GlassBridgeAnniversary")
    if not bridge then
        for _, ch in ipairs(Workspace:GetChildren()) do
            if string.find(string.lower(ch.Name), "glass") and string.find(string.lower(ch.Name), "bridge") then
                bridge = ch
                break
            end
        end
    end
    if not bridge then return end

    local glassHolder = bridge:FindFirstChild("GlassHolder") or bridge

    for _, desc in ipairs(glassHolder:GetDescendants()) do
        if desc:IsA("BasePart") then
            local gType = getGlassType(desc)
            if gType then
                if State.glassEspEnabled then
                    local color = Color3.fromRGB(0, 255, 100) -- Real
                    if gType == "delayed" then
                        color = Color3.fromRGB(255, 190, 0)
                    elseif gType == "fake" then
                        color = Color3.fromRGB(255, 40, 40)
                    end

                    local hl = glassHighlights[desc]
                    if not hl or not hl.Parent then
                        hl = Instance.new("Highlight")
                        hl.Name = "GlassHL"
                        hl.Adornee = desc
                        hl.FillColor = color
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.45
                        hl.OutlineTransparency = 0
                        hl.Parent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
                        glassHighlights[desc] = hl
                    else
                        hl.FillColor = color
                    end
                    desc.Material = Enum.Material.Neon
                    desc.Color = color
                end

                if State.fakeSafeGlassEnabled then
                    if gType == "fake" or gType == "delayed" then
                        for _, child in ipairs(desc:GetChildren()) do
                            if child.ClassName == "TouchTransmitter" or child.ClassName == "TouchInterest" then
                                pcall(function() child:Destroy() end)
                            end
                        end
                        desc.CanCollide = true

                        if not safeWalkwayParts[desc] or not safeWalkwayParts[desc].Parent then
                            local plat = Instance.new("Part")
                            plat.Name = "SafeGlassPlatform"
                            plat.Size = Vector3.new(desc.Size.X, 0.4, desc.Size.Z)
                            plat.CFrame = desc.CFrame * CFrame.new(0, 0.35, 0)
                            plat.Anchored = true
                            plat.CanCollide = true
                            plat.CanTouch = false
                            plat.Transparency = 0.65
                            plat.Color = Color3.fromRGB(50, 255, 120)
                            plat.Material = Enum.Material.SmoothPlastic
                            plat.Parent = Workspace
                            safeWalkwayParts[desc] = plat
                        end
                    end
                end
            end
        end
    end
end

