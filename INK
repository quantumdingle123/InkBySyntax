                    clearSpikePlatforms()
                    wasActive = false
                end
                task.wait(0.75)
            end
        end)
        notify("Hide & Seek", "Anti Spike engaged. Level safety platforms active.")
    else
        clearSpikeContainers()
        clearSpikePlatforms()
        notify("Hide & Seek", "Anti Spike dismantled.")
    end
end)

-- [3] Dash Assist (Shared per-mode controller: latch + delta speed + clean role filtering)
local function isValidDashTarget(p, localPlr, enforceEnemyRole)
    if not p or p == localPlr then return false end
    local pChar = p.Character
    if not pChar then return false end

    local pHrp = pChar:FindFirstChild("HumanoidRootPart")
    local pHum = pChar:FindFirstChildOfClass("Humanoid")
    if not pHrp or not pHum or pHum.Health <= 0 then return false end

    if pChar:FindFirstChildOfClass("ForceField") then return false end
    if pChar:GetAttribute("Eliminated") == true or p:GetAttribute("Eliminated") == true then return false end
    if pChar:FindFirstChild("Ghost") or pChar:GetAttribute("Ghost") == true then return false end
    if pChar:GetAttribute("Crawling") == true or pChar:FindFirstChild("Crawling") ~= nil then return false end

    if enforceEnemyRole then
        if isPlayerGuard(p) and not isPlayerHunter(p) then
            return false
        end
        if isPlayerHunter(localPlr) and isPlayerHunter(p) then
            return false
        end
    end

    return true
end

local function createDashAssistController(config)
    local ctrl = {
        enabled = false,
        dashUntil = 0,
        conns = {},
        heartbeatConn = nil,
        charConn = nil,
        baselineSpeed = 16,
        lastSampleTime = 0,
        speedEdgeLocked = false
    }

    local function clearCharConns()
        for _, c in ipairs(ctrl.conns) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(ctrl.conns)
    end

    local function armDash(duration)
        if not ctrl.enabled or not config.isModeActive() then return end
        local targetTime = os.clock() + (duration or 0.5)
        if targetTime > ctrl.dashUntil then
            ctrl.dashUntil = targetTime
        end
    end

    local function bindCharacter(char)
        clearCharConns()
        if not char or not ctrl.enabled then return end
        local hum = char:WaitForChild("Humanoid", 4)
        local hrp = char:WaitForChild("HumanoidRootPart", 4)
        if not hum or not ctrl.enabled or localPlayer.Character ~= char then return end

        local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3) or hum
        if not ctrl.enabled or localPlayer.Character ~= char then return end
        if animator then
            table.insert(ctrl.conns, animator.AnimationPlayed:Connect(function(track)
                if not ctrl.enabled or not config.isModeActive() then return end
                local aName = (track.Animation and track.Animation.Name and string.lower(track.Animation.Name)) or ""
                if string.find(aName, "dash") or string.find(aName, "dodge") or string.find(aName, "lunge") or string.find(aName, "evade") then
                    armDash(0.5)
                    track.Stopped:Connect(function()
                        ctrl.dashUntil = 0
                    end)
                end
            end))
        end

        for _, attrName in ipairs({ "Dashing", "Dash", "IsDashing" }) do
            table.insert(ctrl.conns, char:GetAttributeChangedSignal(attrName):Connect(function()
                if char:GetAttribute(attrName) == true then
                    armDash(0.5)
                end
            end))
            table.insert(ctrl.conns, hum:GetAttributeChangedSignal(attrName):Connect(function()
                if hum:GetAttribute(attrName) == true then
                    armDash(0.5)
                end
            end))
        end

        if hrp then
            table.insert(ctrl.conns, hrp.ChildAdded:Connect(function(child)
                if not ctrl.enabled or not config.isModeActive() then return end
                if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") or child:IsA("VectorForce") then
                    local st = hum:GetState()
                    if st ~= Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Ragdoll then
                        task.defer(function()
                            if hrp and hrp.Parent and child.Parent == hrp then
                                local v = hrp.AssemblyLinearVelocity
                                local hSpd = Vector3.new(v.X, 0, v.Z).Magnitude
                                if (hSpd - ctrl.baselineSpeed >= 10 and hSpd >= 22) or child.Name:lower():find("dash") then
                                    armDash(0.45)
                                end
                            end
                        end)
                    end
                end
            end))
        end
    end

    function ctrl:SetEnabled(enabled)
        ctrl.enabled = enabled
        ctrl.dashUntil = 0
        ctrl.speedEdgeLocked = false
        clearCharConns()

        if ctrl.heartbeatConn then
            pcall(function() ctrl.heartbeatConn:Disconnect() end)
            ctrl.heartbeatConn = nil
        end
        if ctrl.charConn then
            pcall(function() ctrl.charConn:Disconnect() end)
            ctrl.charConn = nil
        end

        if enabled then
            if localPlayer.Character then
                task.spawn(bindCharacter, localPlayer.Character)
            end
            ctrl.charConn = localPlayer.CharacterAdded:Connect(function(newChar)
                if ctrl.enabled then
                    bindCharacter(newChar)
                end
            end)

            ctrl.lastSampleTime = os.clock()
            ctrl.heartbeatConn = RunService.Heartbeat:Connect(function()
                if not ctrl.enabled or not config.isModeActive() then return end
                local myChar = localPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                if not myHrp or not myHum or myHum.Health <= 0 then return end

                local st = myHum:GetState()
                local v = myHrp.AssemblyLinearVelocity
                local hSpd = Vector3.new(v.X, 0, v.Z).Magnitude
                local now = os.clock()

                if st ~= Enum.HumanoidStateType.Freefall and st ~= Enum.HumanoidStateType.Ragdoll then
                    if not ctrl.speedEdgeLocked and (hSpd - ctrl.baselineSpeed >= 14) and hSpd >= 24 then
                        armDash(0.45)
                        ctrl.speedEdgeLocked = true
                    elseif ctrl.speedEdgeLocked and hSpd < math.max(ctrl.baselineSpeed + 4, 22) then
                        ctrl.speedEdgeLocked = false
                    end
                else
                    ctrl.speedEdgeLocked = false
                end

                if now - ctrl.lastSampleTime >= 0.15 then
                    ctrl.baselineSpeed = hSpd
                    ctrl.lastSampleTime = now
                end

                if now < ctrl.dashUntil then
                    local closestHrp = nil
                    local closestDist = 65
                    local closestHunterHrp = nil
                    local closestHunterDist = 65
                    local localIsHunter = config.enforceEnemyRole and isPlayerHunter(localPlayer)
                    for _, p in ipairs(Players:GetPlayers()) do
                        if isValidDashTarget(p, localPlayer, config.enforceEnemyRole) then
                            local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                            local delta = pHrp.Position - myHrp.Position
                            local flatMag = Vector3.new(delta.X, 0, delta.Z).Magnitude
                            local d = delta.Magnitude
                            if flatMag >= 0.5 then
                                if config.enforceEnemyRole and not localIsHunter and isPlayerHunter(p) then
                                    if d < closestHunterDist then
                                        closestHunterDist = d
                                        closestHunterHrp = pHrp
                                    end
                                end
                                if d < closestDist then
                                    closestDist = d
                                    closestHrp = pHrp
                                end
                            end
                        end
                    end
                    local chosenHrp = closestHunterHrp or closestHrp
                    if chosenHrp then
                        local pos = chosenHrp.Position
                        local flatDelta = Vector3.new(pos.X - myHrp.Position.X, 0, pos.Z - myHrp.Position.Z)
                        if flatDelta.Magnitude >= 0.5 then
                            myHrp.CFrame = CFrame.lookAt(myHrp.Position, myHrp.Position + flatDelta)
                        end
                    end
                end
            end)
        end
    end

    return ctrl
end

