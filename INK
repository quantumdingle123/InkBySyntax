-- [3.2] Mini-Game State Detector (500ms Caching)
local cachedGame = nil
local lastGameCheck = 0

local function getCurrentGame()
    if tick() - lastGameCheck < 0.5 then
        return cachedGame
    end
    lastGameCheck = tick()
    local values = Workspace:FindFirstChild("Values")
    local currentGameObj = values and values:FindFirstChild("CurrentGame")
    local rawVal = currentGameObj and currentGameObj.Value
    if rawVal ~= nil and tostring(rawVal) ~= "" then
        cachedGame = tostring(rawVal)
    else
        cachedGame = nil
    end
    return cachedGame
end

local function normalizeGameName(name)
    if type(name) ~= "string" then return "" end
    return string.lower((string.gsub(name, "[^%w]", "")))
end

local function isCurrentGame(gameName)
    return getCurrentGame() == gameName
end

local function isCurrentGameNormalized(targetNorm)
    return normalizeGameName(getCurrentGame()) == targetNorm
end

local cachedHnsMap = nil
local lastHnsMapCheck = 0

local function findHideAndSeekMap(forceRefresh)
    local now = tick()
    if not forceRefresh and (now - lastHnsMapCheck) < 0.5 then
        if cachedHnsMap ~= nil then
            if cachedHnsMap.Parent then
                return cachedHnsMap
            end
            cachedHnsMap = nil
        else
            return nil
        end
    end
    lastHnsMapCheck = now
    local exact = Workspace:FindFirstChild("HideAndSeekMap")
    if exact then
        cachedHnsMap = exact
        return exact
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("Folder") then
            local norm = normalizeGameName(child.Name)
            if string.find(norm, "hideandseek", 1, true) then
                cachedHnsMap = child
                return child
            end
        end
    end
    cachedHnsMap = nil
    return nil
end

local function getHideAndSeekEvidence(forceRefresh)
    local rawGame = getCurrentGame()
    local mapObj = findHideAndSeekMap(forceRefresh)
    local positive = (normalizeGameName(rawGame) == "hideandseek") or (mapObj ~= nil)
    return positive, rawGame, mapObj
end

local function logHideAndSeekDiagnostic(featureLabel)
    local positive, rawGame, mapObj = getHideAndSeekEvidence(true)
    local gameStr = rawGame and tostring(rawGame) or "nil"
    local mapStr = mapObj and mapObj.Name or "none"
    if positive then
        notify(featureLabel, "Gate ACTIVE (CurrentGame=" .. gameStr .. ", Map=" .. mapStr .. ")", 4)
    else
        notify(featureLabel, "Waiting for Hide & Seek (CurrentGame=" .. gameStr .. ", Map=" .. mapStr .. ")", 4)
    end
end

