local function updateKeysESP(localPos, activeObjects)
    if not State.espKeysEnabled then return end
    local foundKeys = {}

    local function processKey(child)
        if not child or not child.Parent or foundKeys[child] then return end
        if string.sub(child.Name, 1, 10) == "DroppedKey" or string.find(child.Name, "Key") then
            local part = child:IsA("BasePart") and child or (child:IsA("Model") and (child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 350 then
                    foundKeys[child] = true
                    activeObjects[child] = true
                    local keySuffix = string.lower(child.Name)
                    local keyConfig = {
                        width = 135,
                        offsetY = 1.6,
                        bgColor = Color3.fromRGB(22, 18, 10),
                        strokeColor = Color3.fromRGB(255, 215, 0),
                        textColor = Color3.fromRGB(255, 225, 80),
                        icon = ESPAssets.KeyCircle,
                        text = "Circle Key [" .. dist .. "m]"
                    }

                    if string.find(keySuffix, "square") then
                        keyConfig.bgColor = Color3.fromRGB(10, 18, 28)
                        keyConfig.strokeColor = Color3.fromRGB(0, 229, 255)
                        keyConfig.textColor = Color3.fromRGB(100, 240, 255)
                        keyConfig.icon = ESPAssets.KeySquare
                        keyConfig.text = "Square Key [" .. dist .. "m]"
                    elseif string.find(keySuffix, "triangle") then
                        keyConfig.bgColor = Color3.fromRGB(28, 10, 15)
                        keyConfig.strokeColor = Color3.fromRGB(255, 45, 85)
                        keyConfig.textColor = Color3.fromRGB(255, 90, 120)
                        keyConfig.icon = ESPAssets.KeyTriangle
                        keyConfig.text = "Triangle Key [" .. dist .. "m]"
                    elseif string.find(keySuffix, "circle") then
                        keyConfig.bgColor = Color3.fromRGB(22, 18, 10)
                        keyConfig.strokeColor = Color3.fromRGB(255, 215, 0)
                        keyConfig.textColor = Color3.fromRGB(255, 225, 80)
                        keyConfig.icon = ESPAssets.KeyCircle
                        keyConfig.text = "Circle Key [" .. dist .. "m]"
                    else
                        local cleanName = string.gsub(child.Name, "DroppedKey", "")
                        if cleanName == "" then cleanName = child.Name end
                        keyConfig.text = cleanName .. " [" .. dist .. "m]"
                    end

                    local entry = createOrGetObjectESP(child, keyConfig)
                    entry.label.Text = keyConfig.text
                    entry.label.TextColor3 = keyConfig.textColor
                    entry.stroke.Color = keyConfig.strokeColor
                    entry.icon.Image = keyConfig.icon
                    entry.gui.Adornee = part
                    entry.gui.Enabled = true
                end
            end
        end
    end

    local effects = Workspace:FindFirstChild("Effects")
    if effects then
        for _, child in ipairs(effects:GetChildren()) do
            processKey(child)
        end
    end
    -- Fallback: check workspace direct children if effects has no keys
    for _, child in ipairs(Workspace:GetChildren()) do
        if string.sub(child.Name, 1, 10) == "DroppedKey" then
            processKey(child)
        end
    end
end

local function updateExitDoorsESP(localPos, activeObjects)
    if not State.espExitDoorsEnabled then return end
    local hnsMap = Workspace:FindFirstChild("HideAndSeekMap")
    if not hnsMap then return end

    local foundDoors = {}
    local function processDoor(door)
        if not door or not door.Parent or foundDoors[door] then return end
        if string.find(string.upper(door.Name), "EXITDOOR") or string.find(string.upper(door.Name), "EXIT") then
            local part = door:IsA("BasePart") and door or (door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 350 then
                    foundDoors[door] = true
                    activeObjects[door] = true
                    local doorConfig = {
                        width = 145,
                        offsetY = 3.5,
                        bgColor = Color3.fromRGB(10, 25, 18),
                        strokeColor = Color3.fromRGB(0, 255, 140),
                        textColor = Color3.fromRGB(80, 255, 180),
                        icon = ESPAssets.ExitDoor,
                        text = "ESCAPE EXIT [" .. dist .. "m]"
                    }
                    local entry = createOrGetObjectESP(door, doorConfig)
                    entry.label.Text = doorConfig.text
                    entry.gui.Adornee = part
                    entry.gui.Enabled = true
                end
            end
        end
    end

    local fixedDoors = hnsMap:FindFirstChild("NEWFIXEDDOORS")
    local floor1 = fixedDoors and fixedDoors:FindFirstChild("Floor1")
    local exitDoorsFolder = floor1 and floor1:FindFirstChild("EXITDOORS")

    if exitDoorsFolder then
        for _, door in ipairs(exitDoorsFolder:GetChildren()) do
            processDoor(door)
        end
    end
    -- Fallback: recursive scan in HideAndSeekMap if no doors found
    if next(foundDoors) == nil then
        for _, desc in ipairs(hnsMap:GetDescendants()) do
            if string.upper(desc.Name) == "EXITDOOR" then
                processDoor(desc)
            end
        end
    end
end

local function updateItemsESP(localPos, activeObjects)
    if not State.espItemsEnabled then return end

    local function checkItem(inst)
        if not inst or not inst.Parent then return end
        if inst.Parent:FindFirstChildOfClass("Humanoid") then
            return
        end

        local isWeapon = false
        local isBandage = false
        local nameLower = string.lower(inst.Name)

        if string.find(nameLower, "revolver") or string.find(nameLower, "gun") or string.find(nameLower, "baton") or string.find(nameLower, "submachine") or inst:FindFirstChild("GunScript") or inst:FindFirstChild("InfoClient") then
            isWeapon = true
        elseif string.find(nameLower, "bandage") or string.find(nameLower, "medkit") then
            isBandage = true
        end

        if isWeapon or isBandage then
            local part = inst:IsA("BasePart") and inst or (inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart"))) or (inst:IsA("Tool") and (inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 250 then
                    activeObjects[inst] = true
                    local itemConfig = isWeapon and {
                        width = 140,
                        offsetY = 1.4,
                        bgColor = Color3.fromRGB(26, 16, 12),
                        strokeColor = Color3.fromRGB(255, 120, 40),
                        textColor = Color3.fromRGB(255, 160, 80),
                        icon = ESPAssets.DroppedWeapon,
                        text = "Weapon [" .. dist .. "m]"
                    } or {
                        width = 135,
                        offsetY = 1.2,
                        bgColor = Color3.fromRGB(10, 25, 20),
                        strokeColor = Color3.fromRGB(0, 245, 160),
                        textColor = Color3.fromRGB(80, 255, 190),
                        icon = ESPAssets.DroppedBandage,
                        text = "Bandage [" .. dist .. "m]"
                    }

                    local entry = createOrGetObjectESP(inst, itemConfig)
                    entry.label.Text = itemConfig.text
                    entry.gui.Adornee = part
                    entry.gui.Enabled = true
                end
            end
        end
    end

    for _, ch in ipairs(Workspace:GetChildren()) do
        if ch:IsA("Tool") or ch:IsA("Model") then checkItem(ch) end
    end
    local fx = Workspace:FindFirstChild("Effects")
    if fx then
        for _, ch in ipairs(fx:GetChildren()) do
            if ch:IsA("Tool") or ch:IsA("Model") then checkItem(ch) end
        end
    end
end

local function refreshAllWorldObjects(localPos)
    local activeObjects = {}
    updateKeysESP(localPos, activeObjects)
    updateExitDoorsESP(localPos, activeObjects)
    updateItemsESP(localPos, activeObjects)

    for inst, entry in pairs(objectEspInstances) do
        if not activeObjects[inst] or not inst.Parent then
            if entry.gui then entry.gui.Enabled = false end
            if not inst.Parent then
                if entry.gui then entry.gui:Destroy() end
                objectEspInstances[inst] = nil
            end
        end
    end
end

local lastESPRefresh = 0
local function refreshESP()
    local now = tick()
    if now - lastESPRefresh < 0.08 then return end
    lastESPRefresh = now

    local cam = Workspace.CurrentCamera or camera
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not cam or not hrp then
        for _, entry in pairs(espInstances) do
            if entry.topGui then entry.topGui.Enabled = false end
            if entry.bottomGui then entry.bottomGui.Enabled = false end
            if entry.hl then entry.hl.Enabled = false end
        end
        for _, entry in pairs(objectEspInstances) do
            if entry.gui then entry.gui.Enabled = false end
        end
        return
    end

    local localPos = hrp.Position

    -- 1. Refresh World Object ESPs (Keys, Doors, Weapons, Bandages)
    refreshAllWorldObjects(localPos)

    -- 2. Refresh Player ESPs
    local candidates = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum = p.Character:FindFirstChildOfClass("Humanoid")
            if pHrp and pHum and pHum.Health > 0 then
                local dist = math.floor((pHrp.Position - localPos).Magnitude)
                if dist <= 300 then
                    table.insert(candidates, { player = p, hrp = pHrp, hum = pHum, dist = dist })
                end
            end
        end
    end

    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    local activeSet = {}
    local renderLimit = math.min(#candidates, 25)

    for i = 1, renderLimit do
        local item = candidates[i]
        local p = item.player
        activeSet[p] = true

        local entry = createOrGetESP(p)
        entry.topGui.Adornee = item.hrp
        entry.bottomGui.Adornee = item.hrp

        -- Top Billboard (Role Header & Ghost Health Bar)
        if State.playerEspEnabled then
            local isHunter = isPlayerHunter(p)
            local isGuard = isPlayerGuard(p)

            if isHunter then
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(40, 5, 10)
                entry.headerStroke.Color = Color3.fromRGB(255, 30, 40)
                entry.roleIcon.Image = ESPAssets.HunterSkull
                entry.nameLabel.Text = "HUNTER [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 60, 70)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = Color3.fromRGB(255, 20, 30)
                    entry.hl.Enabled = true
                end
            elseif isGuard then
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(35, 10, 15)
                entry.headerStroke.Color = Color3.fromRGB(255, 45, 65)
                entry.roleIcon.Image = ESPAssets.GuardIcon
                entry.nameLabel.Text = "GUARD [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 75, 95)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = Color3.fromRGB(255, 30, 50)
                    entry.hl.Enabled = true
                end
            else
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
                entry.headerStroke.Color = Color3.fromRGB(0, 150, 255)
                entry.roleIcon.Image = ESPAssets.ContestantIcon
                entry.nameLabel.Text = p.DisplayName .. " [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(0, 160, 255)
                    entry.hl.Enabled = true
                end
            end
            updatePlayerHealthDisplay(entry, item.hum)
            entry.topGui.Enabled = true
        else
            entry.topGui.Enabled = false
            if entry.hl then entry.hl.Enabled = false end
        end

        -- Bottom Billboard (Power Ability Pill Capsule)
        if State.espPowersEnabled then
            local rawPower = getPlayerPower(p)
            local pInfo = resolvePowerInfo(rawPower)
            if pInfo then
                entry.pIcon.Image = pInfo.icon
                entry.pLabel.Text = pInfo.name
                entry.pLabel.TextColor3 = pInfo.color
                entry.capStroke.Color = pInfo.glowColor
                entry.bottomGui.Enabled = true
            else
                entry.bottomGui.Enabled = false
            end
        else
            entry.bottomGui.Enabled = false
        end
    end

    -- Disable billboard and highlight for all players beyond top 25 or out of range
    for p, entry in pairs(espInstances) do
        if not activeSet[p] then
            if entry.topGui then entry.topGui.Enabled = false end
            if entry.bottomGui then entry.bottomGui.Enabled = false end
            if entry.hl then entry.hl.Enabled = false end
        end
    end
end

local function hookPlayerSignals(player)
    local function onCharAdded(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            table.insert(Connections, hum.HealthChanged:Connect(function()
                if State.playerEspEnabled and espInstances[player] then
                    updatePlayerHealthDisplay(espInstances[player], hum)
                end
            end))
        end
    end

    if player.Character then
        task.spawn(onCharAdded, player.Character)
    end
    table.insert(Connections, player.CharacterAdded:Connect(onCharAdded))
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= localPlayer then
        hookPlayerSignals(p)
    end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(p)
    if p ~= localPlayer then
        hookPlayerSignals(p)
    end
end))

table.insert(Connections, Players.PlayerRemoving:Connect(function(p)
    local entry = espInstances[p]
    if entry then
        if entry.topGui then entry.topGui:Destroy() end
        if entry.bottomGui then entry.bottomGui:Destroy() end
        if entry.hl then entry.hl:Destroy() end
        espInstances[p] = nil
    end
end))

local espRenderConn = nil
local function startESPThread()
    if not espRenderConn then
        espRenderConn = RunService.RenderStepped:Connect(function()
            if State.playerEspEnabled or State.espPowersEnabled or State.espKeysEnabled or State.espExitDoorsEnabled or State.espItemsEnabled then
                refreshESP()
            end
        end)
        table.insert(Connections, espRenderConn)
    end
end

