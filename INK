local silentAimHooked = false

local function initSilentAimHook()
    if silentAimHooked then return end
    silentAimHooked = true
    if typeof(hookmetamethod) == "function" and typeof(getnamecallmethod) == "function" then
        local origNamecall
        origNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = { ... }

            if State.silentAimEnabled and tostring(method) == "FireServer" then
                if self.Name == "FiredGunClient" or self.Name == "ShootRemote" then
                    local targetHead = getBestEnemyHead()
                    if targetHead and args[2] and typeof(args[2]) == "table" then
                        args[2].HitPart = targetHead
                        args[2].TargetInstance = targetHead
                        args[2].ClientRayPosition = targetHead.Position
                        return origNamecall(self, unpack(args))
                    end
                end
            end
            return origNamecall(self, ...)
        end))
    end
end

