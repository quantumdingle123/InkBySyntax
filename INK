    local fixedDoors = hnsMap:FindFirstChild("NEWFIXEDDOORS")
    local floor1 = fixedDoors and fixedDoors:FindFirstChild("Floor1")
    local exitDoorsFolder = floor1 and floor1:FindFirstChild("EXITDOORS")

    if exitDoorsFolder then
        for _, door in ipairs(exitDoorsFolder:GetChildren()) do
            processDoor(door)
        end
    end
    -- Fallback: recursive scan in HideAndSeekMap if no doors found
    if next(foundDoors) == nil then
        for _, desc in ipairs(hnsMap:GetDescendants()) do
            if string.upper(desc.Name) == "EXITDOOR" then
                processDoor(desc)
            end
        end
    end
end

local function updateItemsESP(localPos, activeObjects)
    if not State.espItemsEnabled then return end

    local function checkItem(inst)
        if not inst or not inst.Parent then return end
        if inst.Parent:FindFirstChildOfClass("Humanoid") then
            return
        end

        local isWeapon = false
        local isBandage = false
        local nameLower = string.lower(inst.Name)

        if string.find(nameLower, "revolver") or string.find(nameLower, "gun") or string.find(nameLower, "baton") or string.find(nameLower, "submachine") or inst:FindFirstChild("GunScript") or inst:FindFirstChild("InfoClient") then
            isWeapon = true
        elseif string.find(nameLower, "bandage") or string.find(nameLower, "medkit") then
            isBandage = true
        end

        if isWeapon or isBandage then
            local part = inst:IsA("BasePart") and inst or (inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart"))) or (inst:IsA("Tool") and (inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 250 then
                    activeObjects[inst] = true
                    local itemConfig = isWeapon and {
                        width = 135,
                        offsetY = 1.2,
                        bgColor = Color3.fromRGB(28, 18, 10),
                        strokeColor = Color3.fromRGB(255, 122, 0),
                        textColor = Color3.fromRGB(255, 160, 60),
                        icon = ESPAssets.DroppedWeapon,
                        text = inst.Name .. " [" .. dist .. "m]"
                    } or {
                        width = 135,
                        offsetY = 1.2,
                        bgColor = Color3.fromRGB(10, 25, 20),
                        strokeColor = Color3.fromRGB(0, 245, 160),
                        textColor = Color3.fromRGB(80, 255, 190),
                        icon = ESPAssets.DroppedBandage,
                        text = "Bandage [" .. dist .. "m]"
                    }

                    local entry = createOrGetObjectESP(inst, itemConfig)
                    entry.label.Text = itemConfig.text
                    entry.gui.Adornee = part
                    entry.gui.Enabled = true
                end
            end
        end
    end

    for _, ch in ipairs(Workspace:GetChildren()) do
        if ch:IsA("Tool") or ch:IsA("Model") then checkItem(ch) end
    end
    local fx = Workspace:FindFirstChild("Effects")
    if fx then
        for _, ch in ipairs(fx:GetChildren()) do
            if ch:IsA("Tool") or ch:IsA("Model") then checkItem(ch) end
        end
    end
end

local function refreshAllWorldObjects(localPos)
    local activeObjects = {}
    if State.espKeysEnabled then updateKeysESP(localPos, activeObjects) end
    if State.espExitDoorsEnabled then updateExitDoorsESP(localPos, activeObjects) end
    if State.espItemsEnabled then updateItemsESP(localPos, activeObjects) end

    for obj, entry in pairs(objectEspInstances) do
        if not activeObjects[obj] or not obj.Parent then
            if entry.gui then entry.gui.Enabled = false end
            if not obj.Parent then
                if entry.gui then entry.gui:Destroy() end
                objectEspInstances[obj] = nil
            end
        end
    end
end

-- ------------------------------------------------------------------------------
-- Optimized Throttle & Distance Culling (Max 25 Nearest Players)
-- ------------------------------------------------------------------------------
local lastEspRefresh = 0

local function refreshESP()
    local now = tick()
    if now - lastEspRefresh < 0.08 then return end
    lastEspRefresh = now

    local char = localPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not myHrp then
        for _, entry in pairs(espInstances) do
            if entry.topGui then entry.topGui.Enabled = false end
            if entry.bottomGui then entry.bottomGui.Enabled = false end
            if entry.hl then entry.hl.Enabled = false end
        end
        return
    end

    local localPos = myHrp.Position

    -- World objects refresh (Keys, Exit Doors, Dropped Items)
    refreshAllWorldObjects(localPos)

    -- Player ESP calculations
    local playerDistances = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local pHum = p.Character:FindFirstChildOfClass("Humanoid")
            if pHrp and pHum and pHum.Health > 0 then
                local dist = (pHrp.Position - localPos).Magnitude
                if dist <= 300 then
                    table.insert(playerDistances, {
                        player = p,
                        dist = math.floor(dist),
                        hrp = pHrp,
                        hum = pHum
                    })
                end
            end
        end
    end

    table.sort(playerDistances, function(a, b) return a.dist < b.dist end)

    local activeSet = {}
    local renderLimit = math.min(#playerDistances, 25)

    for i = 1, renderLimit do
        local item = playerDistances[i]
        local p = item.player
        activeSet[p] = true

        local entry = createOrGetESP(p)
        entry.topGui.Adornee = item.hrp
        entry.bottomGui.Adornee = item.hrp

        -- Top Billboard (Role Header & Ghost Health Bar)
        if State.playerEspEnabled then
            local isHunter = p:GetAttribute("IsHunter") == true
            local isGuard = isPlayerGuard(p)

            if isHunter then
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(40, 5, 10)
                entry.headerStroke.Color = Color3.fromRGB(255, 30, 40)
                entry.roleIcon.Image = ESPAssets.HunterSkull
                entry.nameLabel.Text = "HUNTER [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 60, 70)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = Color3.fromRGB(255, 20, 30)
                    entry.hl.Enabled = true
                end
            elseif isGuard then
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(35, 10, 15)
                entry.headerStroke.Color = Color3.fromRGB(255, 45, 65)
                entry.roleIcon.Image = ESPAssets.GuardIcon
                entry.nameLabel.Text = "GUARD [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 75, 95)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = Color3.fromRGB(255, 30, 50)
                    entry.hl.Enabled = true
                end
            else
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
                entry.headerStroke.Color = Color3.fromRGB(0, 150, 255)
                entry.roleIcon.Image = ESPAssets.ContestantIcon
                entry.nameLabel.Text = p.DisplayName .. " [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(0, 160, 255)
                    entry.hl.Enabled = true
                end
            end
            updatePlayerHealthDisplay(entry, item.hum)
            entry.topGui.Enabled = true
        else
            entry.topGui.Enabled = false
            if entry.hl then entry.hl.Enabled = false end
        end

        -- Bottom Billboard (Power Ability Pill Capsule)
        if State.espPowersEnabled then
            local rawPower = getPlayerPower(p)
            local pInfo = resolvePowerInfo(rawPower)
            if pInfo then
                entry.pIcon.Image = pInfo.icon
                entry.pLabel.Text = pInfo.name
                entry.pLabel.TextColor3 = pInfo.color
                entry.capStroke.Color = pInfo.glowColor
                entry.bottomGui.Enabled = true
            else
                entry.bottomGui.Enabled = false
            end
        else
            entry.bottomGui.Enabled = false
        end
    end

    -- Clean up culled players
    for p, entry in pairs(espInstances) do
        if not activeSet[p] then
            if entry.topGui then entry.topGui.Enabled = false end
            if entry.bottomGui then entry.bottomGui.Enabled = false end
            if entry.hl then entry.hl.Enabled = false end
        end
    end
end

