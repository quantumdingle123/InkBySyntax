local createdSpikePlatforms = {}
local spikeDescendantConn = nil

local function protectHazard(arg)
    if not arg or not arg.Parent or arg.Name == "SafeSpikePlatform" then return end
    local name = string.lower(arg.Name)
    if string.find(name, "spike") or string.find(name, "kill") or string.find(name, "trap") or string.find(name, "hazard") then
        if createdSpikePlatforms[arg] then return end

        local cf, size
        if arg:IsA("BasePart") then
            cf = arg.CFrame
            size = arg.Size
            arg.CanTouch = false
            local ti = arg:FindFirstChildOfClass("TouchTransmitter") or arg:FindFirstChild("TouchInterest")
            if ti then pcall(function() ti:Destroy() end) end
        elseif arg:IsA("Model") then
            cf, size = arg:GetBoundingBox()
            for _, desc in ipairs(arg:GetDescendants()) do
                if desc:IsA("BasePart") then
                    desc.CanTouch = false
                    local ti = desc:FindFirstChildOfClass("TouchTransmitter") or desc:FindFirstChild("TouchInterest")
                    if ti then pcall(function() ti:Destroy() end) end
                end
            end
        end

        if cf and size and size.Magnitude > 0 then
            local plat = Instance.new("Part")
            plat.Name = "SafeSpikePlatform"
            plat.Anchored = true
            plat.CanCollide = true
            plat.Transparency = 0.7
            plat.Color = Color3.fromRGB(0, 255, 180)
            plat.Material = Enum.Material.Neon
            plat.Size = Vector3.new(size.X, 0.5, size.Z)
            plat.CFrame = cf * CFrame.new(0, (size.Y / 2) + 0.35, 0)
            plat.Parent = Workspace
            createdSpikePlatforms[arg] = plat
        end
    end
end

