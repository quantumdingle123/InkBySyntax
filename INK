    local powerAttributes = { "_EquippedPower", "EquippedPower", "Power", "CurrentPower", "Ability", "EquippedGuardPower" }

    for _, attr in ipairs(powerAttributes) do
        local val = player:GetAttribute(attr)
        if val ~= nil and val ~= false and val ~= "" and val ~= 0 and val ~= "None" and val ~= "Yok" then
            return tostring(val)
        end
    end

    local char = player.Character
    if char then
        for _, attr in ipairs(powerAttributes) do
            local val = char:GetAttribute(attr)
            if val ~= nil and val ~= false and val ~= "" and val ~= 0 and val ~= "None" and val ~= "Yok" then
                return tostring(val)
            end
        end

        for _, desc in ipairs(char:GetDescendants()) do
            if desc.Name == "_EquippedPower" or desc.Name == "EquippedPower" or desc.Name == "Power" then
                if (desc:IsA("StringValue") or desc:IsA("NumberValue")) and desc.Value ~= "" and desc.Value ~= "None" and desc.Value ~= "Yok" then
                    return tostring(desc.Value)
                end
            end
        end
    end

    return nil
end

local function resolvePowerInfo(powerName)
    if not powerName or powerName == "" then return nil end
    local lower = string.lower(powerName)
    if lower == "none" or lower == "yok" or lower == "false" or lower == "nil" then
        return nil
    end

    if string.find(lower, "quick") or string.find(lower, "silver") or string.find(lower, "speed") then
        return {
            name = "Quicksilver",
            icon = ESPAssets.Quicksilver,
            color = Color3.fromRGB(0, 235, 255),
            glowColor = Color3.fromRGB(0, 160, 255)
        }
    elseif string.find(lower, "light") or string.find(lower, "god") or string.find(lower, "thunder") or string.find(lower, "volt") then
        return {
            name = "Lightning God",
            icon = ESPAssets.LightningGod,
            color = Color3.fromRGB(255, 215, 0),
            glowColor = Color3.fromRGB(255, 160, 0)
        }
    elseif string.find(lower, "instinct") or string.find(lower, "ultra") or string.find(lower, "dodge") then
        return {
            name = "Ultra Instinct",
            icon = ESPAssets.UltraInstinct,
            color = Color3.fromRGB(215, 240, 255),
            glowColor = Color3.fromRGB(140, 190, 255)
        }
    elseif string.find(lower, "reality") or string.find(lower, "jump") or string.find(lower, "teleport") or string.find(lower, "portal") then
        return {
            name = "Reality Jumper",
            icon = ESPAssets.RealityJumper,
            color = Color3.fromRGB(255, 80, 220),
            glowColor = Color3.fromRGB(180, 40, 230)
        }
    else
        return {
            name = powerName,
            icon = ESPAssets.GenericPower,
            color = Color3.fromRGB(0, 180, 255),
            glowColor = Color3.fromRGB(0, 120, 230)
        }
    end
end

