local antiCrawlConn = nil

local function purgeCrawling(char)
    if not char then return end
    local crawling = char:FindFirstChild("Crawling")
    if crawling then
        pcall(function() crawling:Destroy() end)
    end
    if char:GetAttribute("Crawling") then
        char:SetAttribute("Crawling", false)
    end
    if char:GetAttribute("Downed") then
        char:SetAttribute("Downed", false)
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.PlatformStand then hum.PlatformStand = false end
        local state = hum:GetState()
        if state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.Seated then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

        -- Stop active crawling animation tracks
        local animator = hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local animName = string.lower(track.Name or "")
                if string.find(animName, "crawl") or string.find(animName, "downed") then
                    track:Stop()
                end
            end
        end
    end
end

local function hookAntiCrawl(char)
    if antiCrawlConn then
        antiCrawlConn:Disconnect()
        antiCrawlConn = nil
    end
    if not char then return end
    antiCrawlConn = char.ChildAdded:Connect(function(child)
        if State.antiCrawlEnabled and child.Name == "Crawling" then
            task.defer(function() pcall(function() child:Destroy() end) end)
        end
    end)
end

