local mingleDoorClosing = false

local function getMyMingleRoomDoor()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local mingleMap = Workspace:FindFirstChild("MingleMap")
    local allDoors = mingleMap and mingleMap:FindFirstChild("AllMingleDoors")
    if not hrp or not allDoors then return nil end
    local pos = hrp.Position

    for _, door in pairs(allDoors:GetChildren()) do
        local insideCheck = door:FindFirstChild("InsideRoomRayCheck")
        if insideCheck and insideCheck:IsA("BasePart") then
            local rel = insideCheck.CFrame:PointToObjectSpace(pos)
            if math.abs(rel.X) <= 10 and math.abs(rel.Z) <= 12 and math.abs(rel.Y) <= 10 then
                return door
            end
        end
    end
    return nil
end

local function closeMingleDoor(door)
    if not door or mingleDoorClosing then return end
    mingleDoorClosing = true

    local doorHandle = door:FindFirstChild("DoorHandleOtherSide") or door:FindFirstChild("DoorHandle")
    local closePrompt = doorHandle and doorHandle:FindFirstChild("CloseDoorPrompt")

    if closePrompt and closePrompt:IsA("ProximityPrompt") then
        pcall(function()
            closePrompt.HoldDuration = 0
            closePrompt.RequiresLineOfSight = false
            closePrompt.MaxActivationDistance = 9999
            firePrompt(closePrompt)
        end)
    end

    local openOrCloseBD = door:FindFirstChild("OpenOrCloseBD")
    if openOrCloseBD and openOrCloseBD:IsA("BindableEvent") then
        pcall(function() openOrCloseBD:Fire("Close") end)
    end

    task.delay(3, function()
        mingleDoorClosing = false
    end)
end

