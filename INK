local activeSpikePlatforms = {}
local spikeDescendantConn = nil

local function processSpikeObject(arg)
    if not arg or not arg.Parent or arg.Name == "SafeSpikePlatform" then return end
    if string.find(string.lower(arg.Name), "spike") or string.find(string.lower(arg.Name), "trap") then
        local targetPart = arg:IsA("BasePart") and arg or (arg:IsA("Model") and (arg.PrimaryPart or arg:FindFirstChildWhichIsA("BasePart")))
        if targetPart and targetPart.CanCollide then
            pcall(function()
                targetPart.CanTouch = false
            end)
            if not activeSpikePlatforms[targetPart] then
                local plat = Instance.new("Part")
                plat.Name = "SafeSpikePlatform"
                plat.Size = targetPart.Size + Vector3.new(0.5, 1.2, 0.5)
                plat.CFrame = targetPart.CFrame * CFrame.new(0, 0.6, 0)
                plat.Anchored = true
                plat.CanCollide = true
                plat.Transparency = 0.45
                plat.Material = Enum.Material.ForceField
                plat.Color = Color3.fromRGB(0, 255, 140)
                plat.CastShadow = false
                local container = Workspace:FindFirstChild("SafeSpikeContainer") or Instance.new("Folder", Workspace)
                container.Name = "SafeSpikeContainer"
                plat.Parent = container
                activeSpikePlatforms[targetPart] = plat
            end
        end
    end
end

