local function updatePlayerHealthDisplay(entry, hum)
    if not entry or not hum then return end
    local maxHealth = (hum.MaxHealth and hum.MaxHealth > 0) and hum.MaxHealth or 100
    local health = math.clamp(hum.Health, 0, maxHealth)
    local pct = math.clamp(health / maxHealth, 0, 1)

    -- Dynamic Color Shift
    local barColor = Color3.fromRGB(0, 255, 140)
    if pct <= 0.25 then
        barColor = Color3.fromRGB(255, 40, 40)
    elseif pct <= 0.6 then
        barColor = Color3.fromRGB(255, 190, 0)
    end
    entry.fillBar.BackgroundColor3 = barColor

    -- Fast tween for active fill
    TweenService:Create(entry.fillBar, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(pct, 0, 1, 0)
    }):Play()

    -- Slower sine tween for ghost damage trail
    TweenService:Create(entry.trailBar, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
        Size = UDim2.new(pct, 0, 1, 0)
    }):Play()
end

