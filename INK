local function setMingleDoorCollision(collide)
    local mingleMap = Workspace:FindFirstChild("MingleMap")
    local doors = mingleMap and mingleMap:FindFirstChild("AllMingleDoors")
    if not doors then return end

    for _, door in pairs(doors:GetChildren()) do
        local union = door:FindFirstChild("Union")
        if union then
            union.CanCollide = collide
            union.Transparency = collide and 0 or 0.4
        end
        local h1 = door:FindFirstChild("DoorHandle")
        if h1 then h1.CanCollide = collide end
        local h2 = door:FindFirstChild("DoorHandleOtherSide")
        if h2 then h2.CanCollide = collide end
    end
end

