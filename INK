local UtilitiesTab = Window:CreateTab("Utilities", "Wrench")

-- ------------------------------------------------------------------------------
-- [4.1] Player & World ESP
-- ------------------------------------------------------------------------------
local CatESP = UtilitiesTab:CreateCategory("Player & World ESP", true, 1)

local espHighlights = {}

local function updatePlayerESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and State.playerEspEnabled then
                if not espHighlights[p] then
                    local hl = Instance.new("Highlight")
                    hl.Name = "InkPlayerHL"
                    hl.Adornee = char
                    hl.FillColor = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(0, 160, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0.1
                    hl.Parent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
                    espHighlights[p] = hl
                end
            elseif espHighlights[p] then
                espHighlights[p]:Destroy()
                espHighlights[p] = nil
            end
        elseif espHighlights[p] then
            espHighlights[p]:Destroy()
            espHighlights[p] = nil
        end
    end
end

CatESP:CreateToggle("Player ESP", "Outlines players and displays team/health info", false, function(enabled)
    State.playerEspEnabled = enabled
    if enabled then
        table.insert(Connections, RunService.RenderStepped:Connect(function()
            if State.playerEspEnabled then updatePlayerESP() end
        end))
    else
        for _, hl in pairs(espHighlights) do if hl then hl:Destroy() end end
        table.clear(espHighlights)
    end
end)

