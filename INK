-- [4.1] Dynamic Name Generator (Evades Static Detection)
local function generateId(length)
    length = length or 32
    local ok, guid = pcall(function()
        return HttpService:GenerateGUID(false)
    end)
    if ok and guid then
        return string.gsub(guid, "-", "")
    end
    local charset = "abcdef0123456789"
    local str = ""
    for _ = 1, length do
        local n = math.random(1, #charset)
        str = str .. string.sub(charset, n, n)
    end
    return str
end

-- [4.2] Physics-Safe Pivot Teleportation
local function safePivot(targetCFrame)
    local character = localPlayer.Character
    if not character then return end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoidRootPart then return end

    pcall(function()
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        humanoidRootPart.Velocity = Vector3.zero
        humanoidRootPart.RotVelocity = Vector3.zero
        humanoidRootPart.CanCollide = false
        humanoidRootPart.Anchored = true
    end)

    RunService.Heartbeat:Wait()

    pcall(function()
        character:PivotTo(targetCFrame)
    end)

    RunService.Heartbeat:Wait()

    pcall(function()
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        humanoidRootPart.Velocity = Vector3.zero
        humanoidRootPart.RotVelocity = Vector3.zero
        humanoidRootPart.Anchored = false
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end

-- [4.3] Virtual Hardware Keypress Simulator
local VirtualKeycodes = {
    w = 87, a = 65, s = 83, d = 68, space = 32,
    e = 69, q = 81, f = 70, r = 82, t = 84,
    y = 89, x = 88, c = 67, v = 86, b = 66,
    g = 71, h = 72, z = 90,
    ["1"] = 49, ["2"] = 50, ["3"] = 51, ["4"] = 52, ["5"] = 53,
    ["6"] = 54, ["7"] = 55, ["8"] = 56, ["9"] = 57, ["0"] = 48
}

local function simulateKey(keyName)
    if typeof(keypress) == "function" and typeof(keyrelease) == "function" then
        local code = VirtualKeycodes[string.lower(tostring(keyName))]
        if code then
            keypress(code)
            task.wait(math.random(35, 65) / 1000)
            keyrelease(code)
            return true
        end
    end
    return false
end

-- [4.4] Mini-Game State Detector (500ms Caching)
local cachedGame = nil
local lastGameCheck = 0

local function getCurrentGame()
    if tick() - lastGameCheck < 0.5 then
        return cachedGame
    end
    lastGameCheck = tick()
    local values = Workspace:FindFirstChild("Values")
    local currentGameObj = values and values:FindFirstChild("CurrentGame")
    if currentGameObj and currentGameObj.Value ~= "" then
        cachedGame = currentGameObj.Value
    else
        cachedGame = nil
    end
    return cachedGame
end

local function isCurrentGame(gameName)
    return getCurrentGame() == gameName
end

-- [4.5] Remote Introspection & GC Bypass Engine
local RemoteEngine = { Cache = {} }

function RemoteEngine:GetWrapper(remoteName)
    if self.Cache[remoteName] then
        return self.Cache[remoteName]
    end

    local searchGC = (typeof(filtergc) == "function" and function() return filtergc("table", {}, false) end)
        or (typeof(getgc) == "function" and function() return getgc(true) end)

    if searchGC and typeof(debug.getupvalue) == "function" then
        local ok, tables = pcall(searchGC)
        if ok and type(tables) == "table" then
            for _, tbl in ipairs(tables) do
                if typeof(tbl) == "table" then
                    local ok2, fire = pcall(rawget, tbl, "FireServer")
                    if ok2 and typeof(fire) == "function" and (not islclosure or islclosure(fire)) then
                        for i = 1, 40 do
                            local ok3, upval = pcall(debug.getupvalue, fire, i)
                            if ok3 and typeof(upval) == "Instance" and upval:IsA("RemoteEvent") and upval.Name == remoteName then
                                self.Cache[remoteName] = tbl
                                return tbl
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

function RemoteEngine:Fire(remoteName, ...)
    local wrapper = self:GetWrapper(remoteName)
    if wrapper and typeof(wrapper.FireServer) == "function" then
        return select(1, pcall(wrapper.FireServer, wrapper, ...))
    end
    local direct = ReplicatedStorage:FindFirstChild(remoteName, true)
    if direct and direct:IsA("RemoteEvent") then
        return select(1, pcall(direct.FireServer, direct, ...))
    end
    return false
end

function RemoteEngine:UseTool(toolName, moveName, data)
    if not toolName then return false end
    return self:Fire("UsedTool", moveName or "UsingMoveCustom", toolName, nil, data or { Clicked = true })
end

