local function getEquippedGun()
    local char = localPlayer.Character
    if not char then return nil end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and (item:FindFirstChild("GunScript") or item:FindFirstChild("InfoClient") or string.find(string.lower(item.Name), "gun") or string.find(string.lower(item.Name), "revolver") or string.find(string.lower(item.Name), "submachine")) then
            return item
        end
    end
    return nil
end

local function modifyGunModule(gunTool)
    if not gunTool then return end
    local infoModule = gunTool:FindFirstChild("InfoClient") or gunTool:FindFirstChild("GunConfig") or gunTool:FindFirstChild("Config")
    if infoModule and infoModule:IsA("ModuleScript") then
        pcall(function()
            local gunData = require(infoModule)
            if type(gunData) == "table" then
                if State.noRecoilEnabled then
                    gunData.Recoil = 0
                    gunData.CameraShakingEnabled = false
                    gunData.ScreenShake = 0
                end
                if State.rapidFireEnabled then
                    gunData.ShootRate = 0.04
                    gunData.FireRate = 0.04
                    gunData.Automatic = true
                end
                if State.infiniteAmmoEnabled then
                    gunData.Ammo = 9999
                    gunData.MaxAmmo = 9999
                    gunData.AmmoPerMag = 9999
                end
            end
        end)
    end
end

