    local hnsMap = Workspace:FindFirstChild("HideAndSeekMap")
    if not hnsMap then return end

    local foundDoors = {}
    local function processDoor(door)
        if not door or not door.Parent or foundDoors[door] then return end
        if string.find(string.upper(door.Name), "EXITDOOR") or string.find(string.upper(door.Name), "EXIT") then
            local part = door:IsA("BasePart") and door or (door:IsA("Model") and (door.PrimaryPart or door:FindFirstChildWhichIsA("BasePart")))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 350 then
                    foundDoors[door] = true
                    activeObjects[door] = true
                    local doorConfig = {
                        showLabel = false,
                        iconSize = 22,
                        offsetY = 3.5,
                        bgColor = Color3.fromRGB(10, 25, 18),
                        strokeColor = Color3.fromRGB(0, 255, 140),
                        textColor = Color3.fromRGB(80, 255, 180),
                        icon = ESPAssets.ExitDoor,
                        text = "ESCAPE EXIT [" .. dist .. "m]"
                    }
                    local entry = createOrGetObjectESP(door, doorConfig)
                    entry.label.Text = doorConfig.text
                    entry.label.TextColor3 = doorConfig.textColor
                    entry.stroke.Color = doorConfig.strokeColor
                    entry.capsule.BackgroundColor3 = doorConfig.bgColor
                    entry.icon.Image = doorConfig.icon
                    entry.gui.Adornee = part
                    entry.gui.Enabled = true
                end
            end
        end
    end

    local fixedDoors = hnsMap:FindFirstChild("NEWFIXEDDOORS")
    local floor1 = fixedDoors and fixedDoors:FindFirstChild("Floor1")
    local exitDoorsFolder = floor1 and floor1:FindFirstChild("EXITDOORS")

    if exitDoorsFolder then
        for _, door in ipairs(exitDoorsFolder:GetChildren()) do
            processDoor(door)
        end
    end
    -- Fallback: recursive scan in HideAndSeekMap if no doors found
    if next(foundDoors) == nil then
        for _, desc in ipairs(hnsMap:GetDescendants()) do
            if string.upper(desc.Name) == "EXITDOOR" then
                processDoor(desc)
            end
        end
    end
end

local ITEM_DROP_FOLDER_NAMES = {
    drops = true, items = true, pickups = true, loot = true, weapons = true, dropped = true
}
local STRICT_WEAPON_TOKENS = {
    revolver = true, baton = true, submachine = true, pistol = true,
    rifle = true, shotgun = true, knife = true, firearm = true,
    smg = true, glock = true, ak47 = true, mp5 = true, m4a1 = true, crowbar = true
}
local STRICT_BANDAGE_TOKENS = {
    bandage = true, bandages = true, medkit = true, medbag = true, firstaid = true
}
local LOOSE_WEAPON_SUBSTRS = {
    "revolver", "gun", "baton", "submachine", "pistol", "rifle", "shotgun", "knife", "weapon", "mp5", "smg", "ammo", "bat"
}
local LOOSE_BANDAGE_SUBSTRS = {
    "bandage", "medkit", "medbag", "firstaid", "heal"
}

local cachedItemCandidates = {}
local lastItemScanTime = 0

local function hasHumanoidAncestor(inst)
    local cur = inst
    while cur and cur ~= Workspace do
        if cur:IsA("Model") and (Players:GetPlayerFromCharacter(cur) or cur:FindFirstChildOfClass("Humanoid")) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function tokenizeItemName(name)
    if type(name) ~= "string" then return {} end
    local spaced = string.gsub(name, "([%l])([%u])", "%1 %2")
    spaced = string.gsub(spaced, "([%u])([%u][%l])", "%1 %2")
    local tokens = {}
    for tok in string.gmatch(string.lower(spaced), "[%a%d]+") do
        tokens[tok] = true
    end
    return tokens
end

local function matchesStrictTokens(tokens, tokenSet)
    for tok in pairs(tokens) do
        if tokenSet[tok] then
            return true
        end
        local stem = string.match(tok, "^(%a%a%a+)%d+$")
        if stem and tokenSet[stem] then
            return true
        end
    end
    return false
end

local function matchesAnySubstr(nameLower, list)
    for _, sub in ipairs(list) do
        if string.find(nameLower, sub, 1, true) then
            return true
        end
    end
    return false
end

local function classifyItemInstance(inst, inDropFolder)
    if not inst or not inst.Parent then return nil end
    if hasHumanoidAncestor(inst) then return nil end

    if inst:FindFirstChild("GunScript") or inst:FindFirstChild("InfoClient") or inst:FindFirstChild("Gun") then
        return "weapon"
    end

    local tokens = tokenizeItemName(inst.Name)
    if matchesStrictTokens(tokens, STRICT_WEAPON_TOKENS) then
        return "weapon"
    end
    if matchesStrictTokens(tokens, STRICT_BANDAGE_TOKENS) or (tokens.first and tokens.aid) or (tokens.med and tokens.kit) then
        return "bandage"
    end

    local looseOk = inDropFolder or inst:IsA("Tool") or (inst:FindFirstChild("Handle") ~= nil)
    if looseOk then
        local nameLower = string.lower(inst.Name)
        if matchesAnySubstr(nameLower, LOOSE_WEAPON_SUBSTRS) then
            return "weapon"
        elseif matchesAnySubstr(nameLower, LOOSE_BANDAGE_SUBSTRS) then
            return "bandage"
        end
    end

    return nil
end

local function rebuildItemCandidates()
    table.clear(cachedItemCandidates)
    local addedSet = {}

    local function tryAddCandidate(inst, inDropFolder)
        if not inst or addedSet[inst] then return end
        if not (inst:IsA("Tool") or inst:IsA("Model") or inst:IsA("BasePart")) then return end

        local anc = inst.Parent
        while anc and anc ~= Workspace do
            if addedSet[anc] then return end
            anc = anc.Parent
        end

        local kind = classifyItemInstance(inst, inDropFolder)
        if kind then
            addedSet[inst] = true
            table.insert(cachedItemCandidates, { inst = inst, kind = kind })
        end
    end

    for _, ch in ipairs(Workspace:GetChildren()) do
        if ITEM_DROP_FOLDER_NAMES[normalizeGameName(ch.Name)] then
            for _, desc in ipairs(ch:GetDescendants()) do
                tryAddCandidate(desc, true)
            end
        else
            tryAddCandidate(ch, false)
        end
    end

    local fx = Workspace:FindFirstChild("Effects")
    if fx then
        for _, desc in ipairs(fx:GetDescendants()) do
            local inDrop = desc.Parent ~= nil and ITEM_DROP_FOLDER_NAMES[normalizeGameName(desc.Parent.Name)] or false
            tryAddCandidate(desc, inDrop)
        end
    end
end

local function updateItemsESP(localPos, activeObjects)
    if not State.espItemsEnabled then return end

    local now = tick()
    if (now - lastItemScanTime) >= 0.6 then
        lastItemScanTime = now
        rebuildItemCandidates()
    end

    for _, itemEntry in ipairs(cachedItemCandidates) do
        local inst = itemEntry.inst
        if inst and inst.Parent and inst:IsDescendantOf(Workspace) then
            local part = inst:IsA("BasePart") and inst
                or (inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)))
                or (inst:IsA("Tool") and (inst:FindFirstChild("Handle") or inst:FindFirstChildWhichIsA("BasePart", true)))
            if part then
                local dist = math.floor((part.Position - localPos).Magnitude)
                if dist <= 450 then
                    activeObjects[inst] = true
                    local itemConfig = (itemEntry.kind == "weapon") and {
                        showLabel = false,
                        iconSize = 22,
                        offsetY = 1.4,
                        maxDistance = 500,
                        bgColor = Color3.fromRGB(26, 16, 12),
                        strokeColor = Color3.fromRGB(255, 120, 40),
                        textColor = Color3.fromRGB(255, 160, 80),
                        icon = ESPAssets.DroppedWeapon,
                        text = ""
                    } or {
                        showLabel = false,
                        iconSize = 22,
                        offsetY = 1.2,
                        maxDistance = 500,
                        bgColor = Color3.fromRGB(10, 25, 20),
                        strokeColor = Color3.fromRGB(0, 245, 160),
                        textColor = Color3.fromRGB(80, 255, 190),
                        icon = ESPAssets.DroppedBandage,
                        text = ""
                    }

                    local entry = createOrGetObjectESP(inst, itemConfig)
                    entry.label.Text = itemConfig.text
                    entry.label.TextColor3 = itemConfig.textColor
                    entry.stroke.Color = itemConfig.strokeColor
                    entry.capsule.BackgroundColor3 = itemConfig.bgColor
                    entry.icon.Image = itemConfig.icon
