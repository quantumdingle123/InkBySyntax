    State.antiCrawlEnabled = enabled
    if enabled then
        purgeCrawling(localPlayer.Character)
        hookAntiCrawl(localPlayer.Character)

        if not Connections.antiCrawlCharAdded then
            Connections.antiCrawlCharAdded = localPlayer.CharacterAdded:Connect(function(newChar)
                if State.antiCrawlEnabled then
                    task.wait(0.2)
                    purgeCrawling(newChar)
                    hookAntiCrawl(newChar)
                end
            end)
        end

        Threads.antiCrawlLoop = task.spawn(function()
            while State.antiCrawlEnabled do
                purgeCrawling(localPlayer.Character)
                task.wait(0.2)
            end
        end)
        notify("RLGL", "Anti Crawl engaged.")
    else
        if antiCrawlConn then
            antiCrawlConn:Disconnect()
            antiCrawlConn = nil
        end
        Threads.antiCrawlLoop = nil
        notify("RLGL", "Anti Crawl disengaged.")
    end
end)

