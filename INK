local function updateItemsESP(localPos, activeObjects)
    if not State.espItemsEnabled then return end

    local function scanContainer(container)
        if not container then return end
        for _, inst in ipairs(container:GetChildren()) do
            local isItem = false
            local isWeapon = false
            local isBandage = false

            if inst:IsA("Tool") or (inst:IsA("Model") and (inst:FindFirstChild("GunScript") or inst:FindFirstChild("InfoClient") or inst:FindFirstChild("Handle"))) then
                local lowerName = string.lower(inst.Name)
                if string.find(lowerName, "gun") or string.find(lowerName, "revolver") or string.find(lowerName, "submachine") or string.find(lowerName, "baton") or string.find(lowerName, "crowbar") then
                    isWeapon = true
                    isItem = true
                elseif string.find(lowerName, "bandage") or string.find(lowerName, "heal") or string.find(lowerName, "medkit") then
                    isBandage = true
                    isItem = true
                end
            end

            if isItem then
                local part = inst:IsA("BasePart") and inst or (inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart"))) or inst:FindFirstChild("Handle")
                if part then
                    local dist = math.floor((part.Position - localPos).Magnitude)
                    if dist <= 350 then
                        activeObjects[inst] = true
                        local itemConfig = isWeapon and {
                            width = 140,
                            offsetY = 1.0,
                            bgColor = Color3.fromRGB(25, 16, 10),
                            strokeColor = Color3.fromRGB(255, 140, 0),
                            textColor = Color3.fromRGB(255, 180, 70),
                            icon = ESPAssets.DroppedWeapon,
                            text = inst.Name .. " [" .. dist .. "m]"
                        } or {
                            width = 135,
                            offsetY = 1.0,
                            bgColor = Color3.fromRGB(10, 24, 22),
                            strokeColor = Color3.fromRGB(50, 230, 180),
                            textColor = Color3.fromRGB(120, 255, 215),
                            icon = ESPAssets.DroppedBandage,
                            text = "Bandage [" .. dist .. "m]"
                        }

                        local entry = createOrGetObjectESP(inst, itemConfig)
                        entry.label.Text = itemConfig.text
                        entry.gui.Enabled = true
                    end
                end
            end
        end
    end

    scanContainer(Workspace:FindFirstChild("Effects"))
    scanContainer(Workspace)
end

local function refreshAllWorldObjects(localPos)
    local activeObjects = {}
    updateKeysESP(localPos, activeObjects)
    updateExitDoorsESP(localPos, activeObjects)
    updateItemsESP(localPos, activeObjects)

    for inst, entry in pairs(objectEspInstances) do
        if not activeObjects[inst] then
            if entry.gui then entry.gui.Enabled = false end
            if not inst.Parent then
                if entry.gui then entry.gui:Destroy() end
                objectEspInstances[inst] = nil
            end
        end
    end
end

-- ==============================================================================
-- [REFRESH ESP CYCLE: DISTANCE SORTING & 25-PLAYER MOBILE BUDGET]
-- ==============================================================================
local lastEspRefresh = 0
local function refreshESP()
    local now = tick()
    if now - lastEspRefresh < 0.08 then return end
    lastEspRefresh = now

    local char = safeCharacter()
    local hrp = safeHRP()
    if not char or not hrp then
        for _, entry in pairs(espInstances) do
            if entry.topGui then entry.topGui.Enabled = false end
            if entry.bottomGui then entry.bottomGui.Enabled = false end
            if entry.hl then entry.hl.Enabled = false end
        end
        for _, entry in pairs(objectEspInstances) do
            if entry.gui then entry.gui.Enabled = false end
        end
        return
    end

    local localPos = hrp.Position

    -- Refresh World Objects (Keys, Exit Doors, Items)
    refreshAllWorldObjects(localPos)

    -- Collect all candidates for Player ESP
    local candidates = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer then
            local pChar = p.Character
            local pHrp = pChar and pChar:FindFirstChild("HumanoidRootPart")
            local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")
            if pChar and pHrp and hum and hum.Health > 0 then
                local dist = math.floor((pHrp.Position - localPos).Magnitude)
                if dist <= 300 then
                    table.insert(candidates, { player = p, hrp = pHrp, hum = hum, dist = dist })
                end
            end
        end
    end

    -- Strict distance sort: closest players first, capped to 25
    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    local activeSet = {}
    local renderCap = math.min(#candidates, 25)

    for i = 1, renderCap do
        local item = candidates[i]
        local p = item.player
        activeSet[p] = true

        local entry = createOrGetESP(p)
        entry.topGui.Adornee = item.hrp
        entry.bottomGui.Adornee = item.hrp

        -- Top Billboard (Role Header & Ghost Health Bar)
        if State.playerEspEnabled then
            local isHunter = p:GetAttribute("IsHunter") == true
            local isGuard = isPlayerGuard(p)

            if isHunter then
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(40, 5, 10)
                entry.headerStroke.Color = Color3.fromRGB(255, 30, 40)
                entry.roleIcon.Image = ESPAssets.HunterSkull
                entry.nameLabel.Text = "💀 HUNTER 💀 [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 60, 70)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = Color3.fromRGB(255, 20, 30)
                    entry.hl.Enabled = true
                end
            elseif isGuard then
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(35, 10, 15)
                entry.headerStroke.Color = Color3.fromRGB(255, 45, 65)
                entry.roleIcon.Image = ESPAssets.GuardIcon
                entry.nameLabel.Text = "🔺 GUARD 🔺 [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 75, 95)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = Color3.fromRGB(255, 30, 50)
                    entry.hl.Enabled = true
                end
            else
                entry.headerFrame.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
                entry.headerStroke.Color = Color3.fromRGB(0, 150, 255)
                entry.roleIcon.Image = ESPAssets.ContestantIcon
                entry.nameLabel.Text = p.DisplayName .. " [" .. item.dist .. "m]"
                entry.nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                if entry.hl then
                    entry.hl.Adornee = p.Character
                    entry.hl.FillColor = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(0, 160, 255)
                    entry.hl.Enabled = true
                end
            end
            updatePlayerHealthDisplay(entry, item.hum)
            entry.topGui.Enabled = true
        else
            entry.topGui.Enabled = false
            if entry.hl then entry.hl.Enabled = false end
        end

        -- Bottom Billboard (Power Ability Pill Capsule)
        if State.espPowersEnabled then
            local rawPower = getPlayerPower(p)
            local pInfo = resolvePowerInfo(rawPower)
            if pInfo then
                entry.pIcon.Image = pInfo.icon
                entry.pLabel.Text = pInfo.name
                entry.pLabel.TextColor3 = pInfo.color
                entry.capStroke.Color = pInfo.glowColor
                entry.bottomGui.Enabled = true
            else
                entry.bottomGui.Enabled = false
            end
        else
            entry.bottomGui.Enabled = false
        end
    end

    -- Disable billboard and highlight for all players beyond top 25 or out of range
    for p, entry in pairs(espInstances) do
        if not activeSet[p] then
            if entry.topGui then entry.topGui.Enabled = false end
            if entry.bottomGui then entry.bottomGui.Enabled = false end
            if entry.hl then entry.hl.Enabled = false end
        end
    end
end

