local function setFlightState(enable)
    if enable then
        if Flight.Enabled then return end
        Flight.Enabled = true
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (char and hum and hrp) then return end

        hum.UseJumpPower = false
        hum.AutoRotate = false
        hum.PlatformStand = true

        if Flight.BodyVelocity then Flight.BodyVelocity:Destroy() end
        local bv = Instance.new("BodyVelocity")
        bv.Name = generateId(8)
        bv.MaxForce = Vector3.new(40000, 40000, 40000)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
        Flight.BodyVelocity = bv

        local anim = hum:FindFirstChildOfClass("Animator")
        if anim then
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://112693580156198"
            Flight.AnimationTrack = anim:LoadAnimation(a)
            Flight.AnimationTrack.Priority = Enum.AnimationPriority.Core
            Flight.AnimationTrack.Looped = true
            Flight.AnimationTrack:Play(0.15)
        end

        Flight.Connection = RunService.Heartbeat:Connect(function()
            if not Flight.Enabled or not char or not char.Parent or not hrp or not bv or not hum or hum.Health <= 0 then
                setFlightState(false)
                return
            end
            local cam = Workspace.CurrentCamera
            if not cam then return end
            local cf = cam.CFrame
            local moveVec = Vector3.zero
            local isMoving = false

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + cf.LookVector; isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - cf.LookVector; isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - cf.RightVector; isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + cf.RightVector; isMoving = true end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + cf.UpVector; isMoving = true end

            if not isMoving and hum.MoveDirection.Magnitude > 0.1 then
                local md = hum.MoveDirection
                moveVec = cf.LookVector * md.Z + cf.RightVector * md.X + cf.UpVector * md.Y
                isMoving = true
            end

            if isMoving and moveVec.Magnitude > 0 then
                bv.Velocity = moveVec.Unit * Flight.Speed
            else
                bv.Velocity = Vector3.zero
            end
        end)
    else
        if not Flight.Enabled then return end
        Flight.Enabled = false
        if Flight.Connection then Flight.Connection:Disconnect(); Flight.Connection = nil end
        if Flight.BodyVelocity then Flight.BodyVelocity:Destroy(); Flight.BodyVelocity = nil end
        if Flight.AnimationTrack then Flight.AnimationTrack:Stop(); Flight.AnimationTrack = nil end

        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum then
            hum.UseJumpPower = true
            hum.AutoRotate = true
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
    end
end

