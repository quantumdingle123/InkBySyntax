local function classifyGlassPart(part)
    if not part or not part:IsA("BasePart") then return nil end
    local isGlass = part:GetAttribute("GlassPart") ~= nil or string.find(string.lower(part.Name), "glass") ~= nil
        or (part.Parent and string.find(string.lower(part.Parent.Name), "glass")) or part.Material == Enum.Material.Glass
    if not isGlass then return nil end

    local delayed = part:GetAttribute("DelayedBreaking") ~= nil or (part.Parent and part.Parent:GetAttribute("DelayedBreaking") ~= nil)
    local killing = part:GetAttribute("ActuallyKilling") ~= nil or (part.Parent and part.Parent:GetAttribute("ActuallyKilling") ~= nil)
    local evil = part:GetAttribute("exploitingisevil") == true or (part.Parent and part.Parent:GetAttribute("exploitingisevil") == true)
    local breakable = part:GetAttribute("Breakable") == true or (part.Parent and part.Parent:GetAttribute("Breakable") == true)

    if delayed then return "delayed" end
    if killing or evil or breakable then return "fake" end
    return "real"
end

local glassHighlights = {}
local safePlatCache = {}

local function cleanGlassESP()
    for _, h in pairs(glassHighlights) do
        if h and h.Parent then pcall(function() h:Destroy() end) end
    end
    table.clear(glassHighlights)
end

local function cleanSafeGlass()
    for _, p in pairs(safePlatCache) do
        if p and p.Parent then pcall(function() p:Destroy() end) end
    end
    table.clear(safePlatCache)
end

