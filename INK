    if not (isCurrentGame("HideAndSeek") or Workspace:FindFirstChild("HideAndSeekMap")) then
        notify("Hide & Seek", "Hide & Seek is not currently running.")
        return
    end

    task.spawn(function()
        local char = localPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- Step 1: Collect any missing dropped keys from workspace.Effects
        local reqKeys = { "Circle", "Square", "Triangle" }
        local curKeys = localPlayer:FindFirstChild("CurrentKeys")
        local owned = {}
        if curKeys then
            for _, k in ipairs(curKeys:GetChildren()) do owned[k.Name] = true end
        end

        local fx = Workspace:FindFirstChild("Effects")
        if fx then
            for _, keyName in ipairs(reqKeys) do
                if not owned[keyName] then
                    for _, child in ipairs(fx:GetChildren()) do
                        if string.find(child.Name, "DroppedKey") and string.find(child.Name, keyName) then
                            local pivot = child:IsA("Model") and child:GetPivot() or (child:IsA("BasePart") and child.CFrame)
                            if pivot then
                                local origCF = hrp.CFrame
                                safePhysicsTeleport(pivot)
                                task.wait(0.12)
                                safePhysicsTeleport(origCF)
                                break
                            end
                        end
                    end
                end
            end
        end

        -- Step 2: Trigger exit door interaction if door exists
        local hnsMap = Workspace:FindFirstChild("HideAndSeekMap")
        local fixedDoors = hnsMap and hnsMap:FindFirstChild("NEWFIXEDDOORS")
        local floor1 = fixedDoors and fixedDoors:FindFirstChild("Floor1")
        local exitDoorsFolder = floor1 and floor1:FindFirstChild("EXITDOORS")
        if exitDoorsFolder then
            for _, door in ipairs(exitDoorsFolder:GetChildren()) do
                if string.find(string.upper(door.Name), "EXITDOOR") then
                    for _, prompt in ipairs(door:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            pcall(function() fireproximityprompt(prompt, 0) end)
                        end
                    end
                end
            end
        end

        -- Step 3: Transition player to safe escape zone (Reference Script fn3 position)
        safePhysicsTeleport(CFrame.new(199, 54, -88))
        notify("Hide & Seek", "Safe Door Escape Complete! Teleported to safe zone.")
    end)
end)

