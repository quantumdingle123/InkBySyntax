local function isPlayerHunter(player)
    if not player then return false end
    if player:GetAttribute("IsHunter") == true then return true end
    if player.Team and string.find(string.lower(player.Team.Name), "hunter") then return true end
    local char = player.Character
    if char then
        if char:GetAttribute("IsHunter") == true or char:FindFirstChild("IsHunter") ~= nil then return true end
        if char:FindFirstChild("Bat") or char:FindFirstChild("Baton") or char:FindFirstChild("Crowbar") then return true end
    end
    return false
end

local function isPlayerGuard(player)
    if not player then return false end
    if player:GetAttribute("IsGuard") == true then return true end
    if player.Team and string.find(string.lower(player.Team.Name), "guard") then return true end
    local char = player.Character
    if char then
        if char:FindFirstChild("TypeOfGuard") ~= nil or char:GetAttribute("TypeOfGuard") ~= nil then return true end
        if char:FindFirstChild("GuardCanKillLockOn") ~= nil or char:FindFirstChild("PlayerCanKill") ~= nil then return true end
        if string.find(string.lower(char.Name), "guard") then return true end
        if char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("SubmachineGun") then return true end
    end
    return false
end

local function isValidAimbotTarget(p, localPlr)
    if not p or p == localPlr then return false end
    local pChar = p.Character
    if not pChar then return false end

    -- Verify vital components exist and target is actively alive
    local pHrp = pChar:FindFirstChild("HumanoidRootPart")
    local pHum = pChar:FindFirstChildOfClass("Humanoid")
    if not pHrp or not pHum or pHum.Health <= 0 then return false end

    -- Filter out invulnerable / forcefield-protected targets
    if pChar:FindFirstChildOfClass("ForceField") then return false end

    -- Clean team check: only filter out if both players are on the same assigned team
    if localPlr.Team and p.Team and localPlr.Team == p.Team then
        return false
    end

    return true
end

local function getAimCenter()
    local cam = Workspace.CurrentCamera or camera
    if not cam then return Vector2.zero end
    -- ALWAYS use the exact mathematical center of the camera viewport for detection math (matches zipbomb.txt)
    return cam.ViewportSize / 2
end

local lockedHighlight = nil

local function clearLockedHighlight()
    if lockedHighlight then
        pcall(function()
            lockedHighlight.Adornee = nil
            lockedHighlight:Destroy()
        end)
        lockedHighlight = nil
    end
end

local function updateLockedHighlight(targetChar)
    if not targetChar then
        clearLockedHighlight()
        return
    end
    if not lockedHighlight or not lockedHighlight.Parent then
        lockedHighlight = Instance.new("Highlight")
        local okGuid, guidStr = pcall(function() return HttpService:GenerateGUID(false) end)
        lockedHighlight.Name = (okGuid and guidStr) or "TargetHighlight"
        lockedHighlight.FillColor = Color3.fromRGB(46, 204, 113) -- Emerald Green
        lockedHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        lockedHighlight.FillTransparency = 0.45
        lockedHighlight.OutlineTransparency = 0.1
        lockedHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

        local safeParent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui")
        lockedHighlight.Parent = safeParent
    end
    lockedHighlight.Adornee = targetChar
    lockedHighlight.Enabled = true
end

local function getSmartAimbotTarget(maxFovDistance)
    local fovDiameter = maxFovDistance or State.aimbotFovRadius or 150
    local fovRadius = fovDiameter / 2
    local cam = Workspace.CurrentCamera or camera
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not cam or not hrp then
        clearLockedHighlight()
        return nil, nil
    end

    local myPos = hrp.Position
    local aimCenter = getAimCenter()

    -- 1. Check if Target Lock is active and we have an existing locked target
    if State.aimbotTargetLock and State.lockedTargetPlayer then
        local p = State.lockedTargetPlayer
        if p and p.Parent and p:IsDescendantOf(Players) and isValidAimbotTarget(p, localPlayer) and p.Character then
            local pChar = p.Character
            local pHrp = pChar:FindFirstChild("HumanoidRootPart")
            if pHrp then
                local targetPart = pHrp
                if State.aimbotTargetPart == "Head" then
                    targetPart = pChar:FindFirstChild("Head") or pHrp
                end
                updateLockedHighlight(pChar)
                return p, targetPart
            end
        end
        -- Only drop lock if target is dead, left the server, or became invalid
        State.lockedTargetPlayer = nil
        clearLockedHighlight()
    end

    -- 2. Find closest target in FOV (matching zipbomb.txt closest 3D distance priority)
    local bestTarget = nil
    local bestTargetPart = nil
    local shortest3DDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if isValidAimbotTarget(p, localPlayer) then
            local pChar = p.Character
            local pHrp = pChar:FindFirstChild("HumanoidRootPart")
            local targetPart = pHrp
            if State.aimbotTargetPart == "Head" then
                targetPart = pChar:FindFirstChild("Head") or pHrp
            end

            if targetPart then
                local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                if onScreen and screenPos.Z > 0 then
                    local distance2D = (Vector2.new(screenPos.X, screenPos.Y) - aimCenter).Magnitude
                    if distance2D <= fovRadius then
                        local distance3D = (targetPart.Position - myPos).Magnitude
                        if distance3D < shortest3DDistance then
                            shortest3DDistance = distance3D
                            bestTarget = p
                            bestTargetPart = targetPart
                        end
                    end
                end
            end
        end
    end

    if State.aimbotTargetLock then
        if bestTarget and bestTarget.Character then
            State.lockedTargetPlayer = bestTarget
            updateLockedHighlight(bestTarget.Character)
        else
            State.lockedTargetPlayer = nil
            clearLockedHighlight()
        end
    else
        clearLockedHighlight()
    end

    return bestTarget, bestTargetPart
end

