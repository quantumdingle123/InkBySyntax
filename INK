local function findEquippedOrBackpackGun()
    local char = localPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and (tool:FindFirstChild("GunScript") or tool:FindFirstChild("Client") or tool.Name == "MP5" or tool.Name == "Revolver") then
        return tool
    end
    local bp = localPlayer:FindFirstChild("Backpack")
    if bp then
        for _, ch in ipairs(bp:GetChildren()) do
            if ch.Name == "MP5" or ch.Name == "Revolver" or ch:FindFirstChild("GunScript") then
                ch.Parent = char
                task.wait(0.1)
                return ch
            end
        end
    end
    return nil
end

local function isValidCombatTarget(inst)
    if not inst or not inst.Parent or not inst:IsDescendantOf(Workspace) then return false end
    if inst:FindFirstChild("Dead") or inst:GetAttribute("Dead") == true or inst:GetAttribute("Eliminated") == true then return false end
    if inst:FindFirstChild("IFrame") or inst:GetAttribute("IFrame") == true or inst:FindFirstChildOfClass("ForceField") or inst:FindFirstChild("Invulnerable") then return false end
    if inst:GetAttribute("Injured") == true or inst:GetAttribute("Downed") == true or inst:FindFirstChild("LocalRagdoll") or inst:FindFirstChild("Ragdoll") then return false end
    if inst:GetAttribute("GaveRewardsTo" .. localPlayer.Name) == true then return false end
    local hum = inst:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return true
end

local function getBestEnemyHead()
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local cam = Workspace.CurrentCamera
    local center = cam and Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
    local bestTarget, bestHead = nil, nil
    local minFov = math.huge
    local minDistance = math.huge

    local live = Workspace:FindFirstChild("Live")
    if live then
        for _, ch in ipairs(live:GetChildren()) do
            if ch ~= char and isValidCombatTarget(ch) then
                local head = ch:FindFirstChild("Head") or ch:FindFirstChild("HumanoidRootPart")
                if head then
                    local dist = (hrp.Position - head.Position).Magnitude
                    if dist <= 1200 and cam and center then
                        local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
                        if onScreen and screenPos.Z > 0 then
                            local fov = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                            if fov < minFov then
                                minFov = fov
                                bestTarget = ch
                                bestHead = head
                            end
                        elseif not bestTarget and dist < minDistance then
                            minDistance = dist
                            bestTarget = ch
                            bestHead = head
                        end
                    end
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p:GetAttribute("IsGuard") == true and p.Character and isValidCombatTarget(p.Character) then
            local head = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local dist = (hrp.Position - head.Position).Magnitude
                if dist <= 1200 and cam and center then
                    local screenPos, onScreen = cam:WorldToViewportPoint(head.Position)
                    if onScreen and screenPos.Z > 0 then
                        local fov = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if fov < minFov then
                            minFov = fov
                            bestTarget = p.Character
                            bestHead = head
                        end
                    end
                end
            end
        end
    end

    return bestTarget, bestHead
end

