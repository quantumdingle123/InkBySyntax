-- Smart Crosshair & Touch Aimbot Positioning
local function getAimCenter()
    local cam = Workspace.CurrentCamera or camera
    if not cam then return Vector2.new(0, 0) end
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        return cam.ViewportSize / 2
    else
        return UserInputService:GetMouseLocation()
    end
end

local function getSmartAimbotTarget(maxDist)
    local char = safeCharacter()
    local hrp = safeHRP()
    if not char or not hrp then return nil end
    local cam = Workspace.CurrentCamera or camera
    if not cam then return nil end

    local aimCenter = getAimCenter()
    local bestTarget = nil
    local shortestScreenDist = math.huge
    local fallbackTarget = nil
    local fallbackDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and not Whitelist[p.Name] and not Whitelist[tostring(p.UserId)] then
            local pChar = p.Character
            if pChar and pChar:FindFirstChild("Humanoid") and pChar.Humanoid.Health > 0 then
                local targetPart = pChar:FindFirstChild(State.aimbotTargetPart) or pChar:FindFirstChild("HumanoidRootPart")
                if targetPart then
                    local wPos = targetPart.Position
                    local dist3D = (wPos - hrp.Position).Magnitude
                    if dist3D <= (maxDist or State.aimbotMaxDist or 350) then
                        local screenPos, onScreen = cam:WorldToViewportPoint(wPos)
                        if onScreen and screenPos.Z > 0 then
                            local screenVec = Vector2.new(screenPos.X, screenPos.Y)
                            local screenDist = (screenVec - aimCenter).Magnitude
                            if screenDist <= (State.aimbotFov or 150) and screenDist < shortestScreenDist then
                                shortestScreenDist = screenDist
                                bestTarget = targetPart
                            end
                        end
                        if dist3D < fallbackDistance and dist3D < 40 then
                            fallbackDistance = dist3D
                            fallbackTarget = targetPart
                        end
                    end
                end
            end
        end
    end

    return bestTarget or fallbackTarget
end

