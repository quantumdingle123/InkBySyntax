local function isInsideHumanoidModel(inst)
    if not inst then return false end
    if inst:IsA("Model") and (Players:GetPlayerFromCharacter(inst) or inst:FindFirstChildOfClass("Humanoid")) then
        return true
    end
    local anc = inst.Parent
    while anc and anc ~= Workspace do
        if anc:IsA("Model") and (Players:GetPlayerFromCharacter(anc) or anc:FindFirstChildOfClass("Humanoid")) then
            return true
        end
        anc = anc.Parent
    end
    return false
end

local function findTrackedHazardAncestor(inst)
    local cur = inst and inst.Parent
    while cur and cur ~= Workspace do
        if createdSpikePlatforms[cur] then
            return cur
        end
        cur = cur.Parent
    end
    return nil
end

local function stripHazardPart(part)
    if not part or not part.Parent or part.Name == "SafeSpikePlatform" then return end
    if isInsideHumanoidModel(part) then return end
    if part:IsA("BasePart") then
        pcall(function()
            part.CanTouch = false
            part.CanQuery = false
            part.CanCollide = false
        end)
        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("TouchTransmitter") or child.Name == "TouchInterest" then
                pcall(function() child:Destroy() end)
            end
        end
    end
end

local function computeHazardWorldAABB(root)
    if not root or not root.Parent then return nil end
    local minX, maxX = math.huge, -math.huge
    local minY, maxY = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    local foundPart = false

    local function expandWithPart(p)
        if not p or not p.Parent or p.Name == "SafeSpikePlatform" or not p:IsA("BasePart") then return end
        if isInsideHumanoidModel(p) then return end
        local pCf = p.CFrame
        local hs = p.Size * 0.5
        if hs.Magnitude <= 0 then return end

        local wx = math.abs(pCf.RightVector.X) * hs.X + math.abs(pCf.UpVector.X) * hs.Y + math.abs(pCf.LookVector.X) * hs.Z
        local wy = math.abs(pCf.RightVector.Y) * hs.X + math.abs(pCf.UpVector.Y) * hs.Y + math.abs(pCf.LookVector.Y) * hs.Z
        local wz = math.abs(pCf.RightVector.Z) * hs.X + math.abs(pCf.UpVector.Z) * hs.Y + math.abs(pCf.LookVector.Z) * hs.Z

        local pos = pCf.Position
        if pos.X - wx < minX then minX = pos.X - wx end
        if pos.X + wx > maxX then maxX = pos.X + wx end
        if pos.Y - wy < minY then minY = pos.Y - wy end
        if pos.Y + wy > maxY then maxY = pos.Y + wy end
        if pos.Z - wz < minZ then minZ = pos.Z - wz end
        if pos.Z + wz > maxZ then maxZ = pos.Z + wz end
        foundPart = true
    end

    if root:IsA("BasePart") then
        expandWithPart(root)
    end
    for _, desc in ipairs(root:GetDescendants()) do
        expandWithPart(desc)
    end

    if not foundPart then return nil end
    return { minX = minX, maxX = maxX, minY = minY, maxY = maxY, minZ = minZ, maxZ = maxZ }
end

local function destroyHazardEntry(root)
    local entry = createdSpikePlatforms[root]
    if not entry then return end
    if entry.descConn then
        pcall(function() entry.descConn:Disconnect() end)
        entry.descConn = nil
    end
    if entry.plat and entry.plat.Parent then
        pcall(function() entry.plat:Destroy() end)
    end
    createdSpikePlatforms[root] = nil
end

local function clearSpikePlatforms()
    clearSpikeContainers()
    local roots = {}
    for root in pairs(createdSpikePlatforms) do
        table.insert(roots, root)
    end
    for _, root in ipairs(roots) do
        destroyHazardEntry(root)
    end
    table.clear(createdSpikePlatforms)
end

local function refreshHazardPlatform(root)
    local entry = createdSpikePlatforms[root]
    if not entry then return end
    if not root or not root.Parent then
        destroyHazardEntry(root)
        return
    end

    local aabb = computeHazardWorldAABB(root)
    if not aabb then return end

    -- Keep monotonic maxY so retracting spikes never drop the walkable surface
    if aabb.maxY > entry.maxTopY then
        entry.maxTopY = aabb.maxY
    end

    local sizeX = math.clamp((aabb.maxX - aabb.minX) + 3.5, 4, 80)
    local sizeZ = math.clamp((aabb.maxZ - aabb.minZ) + 3.5, 4, 80)
    local centerX = (aabb.minX + aabb.maxX) * 0.5
    local centerZ = (aabb.minZ + aabb.maxZ) * 0.5
    local targetCF = CFrame.new(centerX, entry.maxTopY + 2.2, centerZ)

    if not entry.plat or not entry.plat.Parent then
        local plat = Instance.new("Part")
        plat.Name = "SafeSpikePlatform"
        plat.Anchored = true
        plat.CanCollide = true
        plat.CanTouch = false
        plat.CanQuery = true -- Keep CanQuery true so Humanoid ground detection sees the platform
        plat.Transparency = 0.6
        plat.Color = Color3.fromRGB(0, 255, 180)
        plat.Material = Enum.Material.Neon
        plat.Size = Vector3.new(sizeX, 1.0, sizeZ)
        plat.CFrame = targetCF
        plat.Parent = Workspace
        entry.plat = plat
    else
        entry.plat.Size = Vector3.new(sizeX, 1.0, sizeZ)
        entry.plat.CFrame = targetCF
    end
    entry.dirty = false
end

local function scheduleHazardRefresh(root)
    local entry = createdSpikePlatforms[root]
    if not entry or entry.refreshQueued then return end
    entry.dirty = true
    entry.refreshQueued = true
    task.defer(function()
        local e = createdSpikePlatforms[root]
        if not e then return end
        e.refreshQueued = false
        if State.antiSpikeEnabled and e.dirty then
            refreshHazardPlatform(root)
        end
    end)
end

local function protectHazard(arg, skipImmediateRefresh, forceHazard, depth)
    depth = depth or 0
    if not arg or not arg.Parent or arg.Name == "SafeSpikePlatform" then return end
    if isInsideHumanoidModel(arg) then return end
    if depth > 4 then return end

    local trackedAnc = findTrackedHazardAncestor(arg)
    if trackedAnc then
        if arg:IsA("BasePart") then
            stripHazardPart(arg)
        elseif arg:IsA("TouchTransmitter") or arg.Name == "TouchInterest" then
            pcall(function() arg:Destroy() end)
        else
            for _, d in ipairs(arg:GetDescendants()) do
                stripHazardPart(d)
            end
        end
        if skipImmediateRefresh then
            createdSpikePlatforms[trackedAnc].dirty = true
        else
            scheduleHazardRefresh(trackedAnc)
        end
        return
    end

    if not (arg:IsA("BasePart") or arg:IsA("Model") or arg:IsA("Folder")) then return end
    local name = string.lower(arg.Name)
    if string.find(name, "trapezoid") or string.find(name, "strap") or string.find(name, "exitdoor") then
        return
    end
    local nameMatched = string.find(name, "spike") or string.find(name, "kill") or string.find(name, "trap") or string.find(name, "hazard")
    if not forceHazard and not nameMatched then
        return
    end

    if forceHazard and arg:IsA("BasePart") and not nameMatched then
        local hasTouch = arg:FindFirstChildOfClass("TouchTransmitter") ~= nil or arg:FindFirstChild("TouchInterest") ~= nil
        local sz = arg.Size
        local isSmallPart = (sz.X <= 12 and sz.Y <= 12 and sz.Z <= 12)
        if not hasTouch and not isSmallPart then
            return
        end
    end

    -- Decompose Folders, oversize Models (>80 studs), and unnamed forced Models into child hazard roots
    local shouldDecompose = false
    if arg:IsA("Folder") then
        shouldDecompose = true
    elseif arg:IsA("Model") then
        if forceHazard and not nameMatched then
            shouldDecompose = true
        else
            local box = computeHazardWorldAABB(arg)
            if box and ((box.maxX - box.minX) > 80 or (box.maxZ - box.minZ) > 80) then
                shouldDecompose = true
            end
        end
    end

    if shouldDecompose then
        if not spikeContainers[arg] then
            local genAtBind = spikeGen
            spikeContainers[arg] = arg.ChildAdded:Connect(function(newChild)
                if State.antiSpikeEnabled and genAtBind == spikeGen and isHideAndSeekActiveWithState(spikeHnsState) then
                    protectHazard(newChild, false, true, depth + 1)
                end
            end)
        end
        for _, ch in ipairs(arg:GetChildren()) do
            protectHazard(ch, skipImmediateRefresh, true, depth + 1)
        end
        return
    end

    if createdSpikePlatforms[arg] then
        if arg:IsA("BasePart") then
            stripHazardPart(arg)
        else
            for _, desc in ipairs(arg:GetDescendants()) do
                stripHazardPart(desc)
            end
        end
        if skipImmediateRefresh then
            createdSpikePlatforms[arg].dirty = true
        else
            scheduleHazardRefresh(arg)
        end
        return
    end

    if arg:IsA("BasePart") then
        stripHazardPart(arg)
    else
        for _, desc in ipairs(arg:GetDescendants()) do
            stripHazardPart(desc)
        end
    end

    local entry = { plat = nil, maxTopY = -math.huge, descConn = nil, dirty = true, refreshQueued = false }
    entry.descConn = arg.DescendantAdded:Connect(function(newDesc)
        if not State.antiSpikeEnabled then return end
        if newDesc:IsA("TouchTransmitter") or newDesc.Name == "TouchInterest" then
            pcall(function() newDesc:Destroy() end)
        elseif newDesc:IsA("BasePart") then
            stripHazardPart(newDesc)
        end
        scheduleHazardRefresh(arg)
    end)
    createdSpikePlatforms[arg] = entry
    if not skipImmediateRefresh then
        refreshHazardPlatform(arg)
    end
end

CatHideSeek:CreateToggle("Anti Spike", "Spawns walkable level safety platforms above spike hazards", false, function(enabled)
    State.antiSpikeEnabled = enabled
    spikeHnsState.lastPositive = 0
    spikeGen += 1
    local gen = spikeGen

    if spikeDescendantConn then
        pcall(function() spikeDescendantConn:Disconnect() end)
        spikeDescendantConn = nil
    end

    if enabled then
        logHideAndSeekDiagnostic("Anti Spike")
        spikeDescendantConn = Workspace.DescendantAdded:Connect(function(desc)
            if State.antiSpikeEnabled and gen == spikeGen and isHideAndSeekActiveWithState(spikeHnsState) then
                -- Skip descendants whose ancestor is already tracked (per-hazard descConn handles them without double refresh)
                if not findTrackedHazardAncestor(desc) then
                    protectHazard(desc, false)
                end
            end
        end)

        task.spawn(function()
            local wasActive = false
            while State.antiSpikeEnabled and gen == spikeGen do
                local activeNow = isHideAndSeekActiveWithState(spikeHnsState)
                if activeNow then
                    if not wasActive then
                        local map = findHideAndSeekMap() or Workspace
                        local count = 0
                        for _, desc in ipairs(map:GetDescendants()) do
                            if not State.antiSpikeEnabled or gen ~= spikeGen then break end
                            protectHazard(desc, true)
                            count += 1
                            if count % 400 == 0 then
                                task.wait()
                            end
                        end
                        -- Single O(N) pass to spawn/size platforms once scan finishes
                        local initRoots = {}
                        for root in pairs(createdSpikePlatforms) do
                            table.insert(initRoots, root)
                        end
                        for _, root in ipairs(initRoots) do
                            if not State.antiSpikeEnabled or gen ~= spikeGen then break end
                            refreshHazardPlatform(root)
                        end
                        wasActive = true
                    else
                        local currentRoots = {}
                        for root in pairs(createdSpikePlatforms) do
                            table.insert(currentRoots, root)
