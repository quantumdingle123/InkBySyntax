                while State.bypassMovementChecks do
                    pcall(function()
                        local rem = ReplicatedStorage:FindFirstChild("Remotes")
                        rem = rem and rem:FindFirstChild("DashRequest") or ReplicatedStorage:FindFirstChild("DashRequest", true)
                        if rem and rem:IsA("RemoteEvent") then
